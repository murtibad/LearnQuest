@{
    ViewData["Title"] = "Admin Panel";
    // We don't want the student sidebar here, so we use a custom admin layout structure within this file for now
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - LearnQuest</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        body { background-color: var(--bg-light); font-family: 'Inter', sans-serif; }
        .admin-sidebar { width: 250px; height: 100vh; position: fixed; background-color: white; border-right: 1px solid #e5e7eb; padding: 24px; }
        .admin-content { margin-left: 250px; padding: 32px; }
        .admin-nav-link { color: var(--text-main); text-decoration: none; padding: 10px 16px; border-radius: 8px; display: flex; align-items: center; gap: 12px; font-weight: 500; margin-bottom: 8px; }
        .admin-nav-link:hover, .admin-nav-link.active { background-color: var(--primary-blue); color: white; }
        
        /* Table Styles for Bento Box feel */
        .table-bento { background: white; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.03); }
        .table-bento th { background-color: #f8fafc; color: var(--text-muted); font-weight: 600; padding: 16px; border-bottom: 2px solid #e5e7eb; }
        .table-bento td { padding: 16px; vertical-align: middle; border-bottom: 1px solid #f3f4f6; }
    </style>
</head>
<body>

    <!-- Admin Sidebar -->
    <aside class="admin-sidebar">
        <div class="d-flex align-items-center gap-2 mb-5">
            <i class="bi bi-shield-lock-fill fs-3 text-primary"></i>
            <span class="fs-5 fw-bold text-dark">Admin Panel</span>
        </div>
        
        <nav class="flex-column">
            <a href="/Admin" class="admin-nav-link active"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            <a href="#" class="admin-nav-link"><i class="bi bi-book-half"></i> Ders Yönetimi</a>
            <a href="#" class="admin-nav-link"><i class="bi bi-people-fill"></i> Kullanıcılar</a>
            <a href="#" class="admin-nav-link"><i class="bi bi-gear-fill"></i> Ayarlar</a>
            
            <hr class="my-4" />
            <a href="/Dashboard" class="admin-nav-link text-muted"><i class="bi bi-box-arrow-left"></i> Öğrenci Ekranına Dön</a>
        </nav>
    </aside>

    <!-- Admin Main Content -->
    <main class="admin-content">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h2 class="fw-bold mb-1">Ders Yönetimi</h2>
                <p class="text-muted">Platformdaki tüm dersleri buradan ekleyebilir veya silebilirsin.</p>
            </div>
            <button class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                <i class="bi bi-plus-lg me-2"></i> Yeni Ders Ekle
            </button>
        </div>

        <!-- Course Management Table (Bento Style) -->
        <div class="table-bento">
            <table class="table table-borderless mb-0">
                <thead>
                    <tr>
                        <th>Ders Adı</th>
                        <th>Kategori</th>
                        <th>Kayıtlı Öğrenci</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Row 1 -->
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary bg-opacity-10 p-2 rounded text-primary"><i class="bi bi-code-slash fs-5"></i></div>
                                <span class="fw-bold">C# Temelleri</span>
                            </div>
                        </td>
                        <td><span class="badge bg-light text-dark border">Programlama</span></td>
                        <td>124 Öğrenci</td>
                        <td><span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">Aktif</span></td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-light text-primary me-2"><i class="bi bi-pencil-fill"></i></button>
                            <button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash-fill"></i></button>
                        </td>
                    </tr>
                    <!-- Row 2 -->
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-success bg-opacity-10 p-2 rounded text-success"><i class="bi bi-database fs-5"></i></div>
                                <span class="fw-bold">SQL Veritabanı</span>
                            </div>
                        </td>
                        <td><span class="badge bg-light text-dark border">Veritabanı</span></td>
                        <td>89 Öğrenci</td>
                        <td><span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">Aktif</span></td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-light text-primary me-2"><i class="bi bi-pencil-fill"></i></button>
                            <button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash-fill"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </main>

</body>
</html>