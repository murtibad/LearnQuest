@{
    ViewData["Title"] = "Admin Panel";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <script src="~/js/site.js"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - LearnQuest</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%234F46E5'><path d='M8 2.223 1 5.373v.13l7 3.15 7-3.15v-.13L8 2.223zm0 6.5-6-2.7v5.47c0 1.25.968 2.378 2.802 2.92C6.183 14.836 7.151 15 8 15c.849 0 1.817-.164 3.198-.587 1.834-.542 2.802-1.67 2.802-2.92V6.023l-6 2.7z'/></svg>">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" />
    
    <style>
        body { background-color: var(--bg-main) !important; color: var(--text-main) !important; font-family: 'Inter', sans-serif; }
        
        .admin-sidebar { width: 250px; height: 100vh; position: fixed; background-color: var(--sidebar-bg); border-right: 1px solid var(--border-color); padding: 24px; display: flex; flex-direction: column; transition: all 0.3s ease; }
        .admin-content { margin-left: 250px; padding: 32px; background-color: var(--bg-main); min-height: 100vh; transition: background-color 0.3s ease; }
        
        .admin-nav-link { color: var(--text-muted); text-decoration: none; padding: 10px 16px; border-radius: 8px; display: flex; align-items: center; gap: 12px; font-weight: 500; margin-bottom: 8px; transition: all 0.3s; }
        .admin-nav-link:hover, .admin-nav-link.active { background-color: var(--hover-bg); color: var(--hover-text); }
        
        .table-bento { background: var(--card-bg); border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border: 1px solid var(--border-color); transition: all 0.3s ease; }
        .table-bento .table { background-color: transparent !important; color: var(--text-main) !important; margin-bottom: 0; }
        .table-bento th { background-color: var(--sidebar-bg) !important; color: var(--text-muted) !important; font-weight: 600; padding: 16px; border-bottom: 1px solid var(--border-color) !important; transition: all 0.3s ease; }
        .table-bento td { padding: 16px; vertical-align: middle; border-bottom: 1px solid var(--border-color) !important; color: var(--text-main) !important; background-color: var(--card-bg) !important; transition: all 0.3s ease; }
        .table-bento tr:hover td { background-color: var(--hover-bg) !important; }
        
        .badge-subtle-success { background-color: rgba(16, 185, 129, 0.1); color: #10b981; }
        .btn-icon { background: transparent; border: none; color: var(--text-muted); transition: color 0.3s; cursor: pointer; }
        .btn-icon:hover { color: var(--text-main); }
        .btn-icon-danger:hover { color: #f87171; }
        
        .theme-btn { background: transparent; border: 1px solid var(--border-color); border-radius: 12px; padding: 10px; width: 100%; text-align: left; display: flex; align-items: center; justify-content: center; gap: 10px; color: var(--text-main); transition: all 0.3s ease; margin-bottom: 10px; cursor: pointer; }
        .theme-btn:hover { background-color: var(--hover-bg); }

        /* Page text colors */
        .admin-content h2 { color: var(--text-main); }
        .admin-content p { color: var(--text-muted); }

        /* Dynamic Modal Styles matching theme variables */
        .modal-content-custom {
            background-color: var(--card-bg);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
            transition: all 0.3s ease;
        }
        .modal-header-custom {
            border-bottom: 1px solid var(--border-color);
            padding: 20px 24px;
        }
        .modal-footer-custom {
            border-top: 1px solid var(--border-color);
            padding: 16px 24px;
        }
        .form-control-modal, .form-select-modal {
            background-color: var(--bg-main);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            border-radius: 12px;
            padding: 12px 16px;
            transition: all 0.3s ease;
        }
        .form-control-modal:focus, .form-select-modal:focus {
            background-color: var(--bg-main);
            border-color: #4F46E5;
            color: var(--text-main);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.2);
        }
        .form-control-modal::placeholder {
            color: var(--text-muted);
        }
    </style>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.6/dist/sweetalert2.min.css" rel="stylesheet">
</head>
<body>
    <aside class="admin-sidebar">
        <div>
            <div class="d-flex align-items-center gap-2 mb-5">
                <i class="bi bi-shield-lock-fill fs-3" style="color: #4F46E5;"></i>
                <span class="fs-5 fw-bold" style="color: var(--text-main);">Admin Panel</span>
            </div>
            <nav class="flex-column">
                <a href="#" class="admin-nav-link" data-target="panel-dashboard"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
                <a href="#" class="admin-nav-link active" data-target="panel-ders"><i class="bi bi-book-half"></i> Ders Yönetimi</a>
                <a href="#" class="admin-nav-link" data-target="panel-users"><i class="bi bi-people-fill"></i> Kullanıcılar</a>
                <a href="#" class="admin-nav-link" data-target="panel-settings"><i class="bi bi-gear-fill"></i> Ayarlar</a>
            </nav>
        </div>
        <div class="mt-auto pb-3">
            <button id="themeToggle" class="theme-btn mb-3">
                <i id="themeIcon" class="bi bi-moon-stars-fill fs-5"></i>
                <span class="fw-medium small">Tema Değiştir</span>
            </button>
            <hr class="mb-4" style="border-color: var(--border-color);" />
            <a href="/Dashboard" class="admin-nav-link"><i class="bi bi-box-arrow-left"></i> Öğrenci Ekranına Dön</a>
        </div>
    </aside>

    <main class="admin-content">
        <div id="panel-ders" class="admin-panel">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <div>
                    <h2 class="fw-bold mb-1">Ders Yönetimi</h2>
                    <p class="text-muted-custom">Platformdaki tüm dersleri buradan ekleyebilir veya silebilirsin.</p>
                </div>
                <!-- Modal Trigger Button -->
                <button class="btn text-white rounded-pill px-4 py-2 fw-bold shadow-sm" style="background-color: #4F46E5;" data-bs-toggle="modal" data-bs-target="#addCourseModal">
                    <i class="bi bi-plus-lg me-2"></i> Yeni Ders Ekle
                </button>
            </div>

            <div class="table-bento skeleton-item">
                <table class="table table-borderless bg-transparent mb-0" id="courseTable">
                    <thead>
                        <tr>
                            <th>Ders Adı</th>
                            <th>Kategori</th>
                            <th>Kayıtlı Öğrenci</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="courseTableBody">
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="p-2 rounded" style="background-color: rgba(79, 70, 229, 0.1); color: #818cf8;"><i class="bi bi-code-slash fs-5"></i></div>
                                    <span class="fw-bold">C# Temelleri</span>
                                </div>
                            </td>
                            <td><span class="badge" style="background-color: rgba(79, 70, 229, 0.1); color: #4F46E5; border: 1px solid rgba(79, 70, 229, 0.2);">Programlama</span></td>
                            <td>124 Öğrenci</td>
                            <td><span class="badge badge-subtle-success rounded-pill px-3 py-2">Aktif</span></td>
                            <td class="text-end">
                                <button class="btn-icon me-2"><i class="bi bi-pencil-fill"></i></button>
                                <button class="btn-icon btn-icon-danger delete-btn"><i class="bi bi-trash-fill"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="p-2 rounded" style="background-color: rgba(16, 185, 129, 0.1); color: #10b981;"><i class="bi bi-database fs-5"></i></div>
                                    <span class="fw-bold">SQL Veritabanı</span>
                                </div>
                            </td>
                            <td><span class="badge" style="background-color: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2);">Veritabanı</span></td>
                            <td>89 Öğrenci</td>
                            <td><span class="badge badge-subtle-success rounded-pill px-3 py-2">Aktif</span></td>
                            <td class="text-end">
                                <button class="btn-icon me-2"><i class="bi bi-pencil-fill"></i></button>
                                <button class="btn-icon btn-icon-danger delete-btn"><i class="bi bi-trash-fill"></i></button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Dashboard Panel -->
        <div id="panel-dashboard" class="admin-panel d-none">
            <div class="mb-5">
                <h2 class="fw-bold mb-1">Dashboard Genel Bakış</h2>
                <p class="text-muted-custom">Sistemin genel istatistikleri ve özet durumu.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="table-bento skeleton-item p-4 d-flex align-items-center gap-3">
                        <div class="p-3 rounded-circle" style="background-color: rgba(79, 70, 229, 0.1); color: #4F46E5;"><i class="bi bi-book fs-3"></i></div>
                        <div>
                            <h3 class="fw-bold mb-0">12</h3>
                            <span class="text-muted-custom small">Aktif Ders</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="table-bento skeleton-item p-4 d-flex align-items-center gap-3">
                        <div class="p-3 rounded-circle" style="background-color: rgba(16, 185, 129, 0.1); color: #10b981;"><i class="bi bi-people fs-3"></i></div>
                        <div>
                            <h3 class="fw-bold mb-0">1,248</h3>
                            <span class="text-muted-custom small">Kayıtlı Öğrenci</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="table-bento skeleton-item p-4 d-flex align-items-center gap-3">
                        <div class="p-3 rounded-circle" style="background-color: rgba(245, 158, 11, 0.1); color: #f59e0b;"><i class="bi bi-star fs-3"></i></div>
                        <div>
                            <h3 class="fw-bold mb-0">4.8</h3>
                            <span class="text-muted-custom small">Ortalama Puan</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Users Panel -->
        <div id="panel-users" class="admin-panel d-none">
            <div class="mb-5">
                <h2 class="fw-bold mb-1">Kullanıcı Yönetimi</h2>
                <p class="text-muted-custom">Platforma kayıtlı öğrencileri ve eğitmenleri yönetin.</p>
            </div>
            <div class="table-bento skeleton-item">
                <table class="table table-borderless bg-transparent mb-0">
                    <thead>
                        <tr>
                            <th>Kullanıcı</th>
                            <th>E-posta</th>
                            <th>Rol</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><div class="fw-bold">Ahmet Yılmaz</div></td>
                            <td>ahmet@subu.edu.tr</td>
                            <td><span class="badge" style="background-color: rgba(16, 185, 129, 0.1); color: #10b981;">Öğrenci</span></td>
                            <td class="text-end"><button class="btn-icon btn-icon-danger"><i class="bi bi-ban"></i></button></td>
                        </tr>
                        <tr>
                            <td><div class="fw-bold">Ayşe Demir</div></td>
                            <td>ayse@subu.edu.tr</td>
                            <td><span class="badge" style="background-color: rgba(16, 185, 129, 0.1); color: #10b981;">Öğrenci</span></td>
                            <td class="text-end"><button class="btn-icon btn-icon-danger"><i class="bi bi-ban"></i></button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Settings Panel -->
        <div id="panel-settings" class="admin-panel d-none">
            <div class="mb-5">
                <h2 class="fw-bold mb-1">Platform Ayarları</h2>
                <p class="text-muted-custom">Sistem yapılandırmalarını ve genel ayarları düzenleyin.</p>
            </div>
            <div class="table-bento skeleton-item p-4" style="max-width: 600px;">
                <div class="mb-4">
                    <label class="form-label fw-bold">Platform Adı</label>
                    <input type="text" class="form-control form-control-modal" value="LearnQuest">
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold">Bakım Modu</label>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="maintenanceMode">
                        <label class="form-check-label text-muted-custom" for="maintenanceMode">Sistemi bakıma al</label>
                    </div>
                </div>
                <button class="btn text-white rounded-pill px-4 fw-bold shadow-sm" style="background-color: #4F46E5;">Ayarları Kaydet</button>
            </div>
        </div>
    </main>

    <!-- Dynamic Theme-Aware Add Course Modal -->
    <div class="modal fade" id="addCourseModal" tabindex="-1" aria-labelledby="addCourseModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-content-custom">
                <div class="modal-header modal-header-custom">
                    <h5 class="modal-title fw-bold" id="addCourseModalLabel">
                        <i class="bi bi-journal-plus me-2" style="color: #4F46E5;"></i>Yeni Ders Ekle
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: brightness(0) invert(0.7);"></button>
                </div>
                <form id="addCourseForm">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label text-muted-custom small fw-medium">Ders Başlığı</label>
                            <input type="text" id="courseTitleInput" class="form-control form-control-modal" placeholder="Örn: Python ile Yapay Zeka" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted-custom small fw-medium">Kategori</label>
                            <select id="courseCategorySelect" class="form-select form-select-modal" required>
                                <option value="Programlama">Programlama</option>
                                <option value="Veritabanı">Veritabanı</option>
                                <option value="Web Geliştirme">Web Geliştirme</option>
                                <option value="Yapay Zeka">Yapay Zeka</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted-custom small fw-medium">İkon Türü</label>
                            <select id="courseIconSelect" class="form-select form-select-modal">
                                <option value="bi-code-slash">Kod (Code)</option>
                                <option value="bi-database">Veritabanı (Database)</option>
                                <option value="bi-cpu">İşlemci / AI (CPU)</option>
                                <option value="bi-globe">Web (Globe)</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer modal-footer-custom">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn text-white rounded-pill px-4 fw-semibold" style="background-color: #4F46E5;">Dersi Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle with Popper (Required for Modals) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Client-side Interactive Table Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const addCourseForm = document.getElementById('addCourseForm');
            const courseTableBody = document.getElementById('courseTableBody');
            const addCourseModalEl = document.getElementById('addCourseModal');
            const modalInstance = new bootstrap.Modal(addCourseModalEl);

            
            // Tab Switching Logic
            const navLinks = document.querySelectorAll(".admin-nav-link[data-target]");
            const panels = document.querySelectorAll(".admin-panel");
            
            navLinks.forEach(link => {
                link.addEventListener("click", (e) => {
                    e.preventDefault();
                    // Remove active from all links
                    navLinks.forEach(l => l.classList.remove("active"));
                    // Hide all panels
                    panels.forEach(p => p.classList.add("d-none"));
                    
                    // Add active to clicked link
                    link.classList.add("active");
                    // Show target panel
                    const targetId = link.getAttribute("data-target");
                    const targetPanel = document.getElementById(targetId);
                    if (targetPanel) {
                        targetPanel.classList.remove("d-none");
                        targetPanel.style.opacity = "0";
                        targetPanel.style.transform = "translateY(10px)";
                        setTimeout(() => {
                            targetPanel.style.transition = "all 0.3s ease";
                            targetPanel.style.opacity = "1";
                            targetPanel.style.transform = "translateY(0)";
                        }, 10);
                    }
                });
            });

            // Handle Add Course Form Submission
            addCourseForm.addEventListener('submit', (e) => {
                e.preventDefault();

                const title = document.getElementById('courseTitleInput').value.trim();
                const category = document.getElementById('courseCategorySelect').value;
                const icon = document.getElementById('courseIconSelect').value;

                if (!title) return;

                // Category Badge Style logic
                let badgeColor = '#4F46E5';
                let badgeBg = 'rgba(79, 70, 229, 0.1)';
                if (category === 'Veritabanı') {
                    badgeColor = '#10b981';
                    badgeBg = 'rgba(16, 185, 129, 0.1)';
                } else if (category === 'Yapay Zeka') {
                    badgeColor = '#f59e0b';
                    badgeBg = 'rgba(245, 158, 11, 0.1)';
                }

                // Create new row
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 rounded" style="background-color: ${badgeBg}; color: ${badgeColor};">
                                <i class="bi ${icon} fs-5"></i>
                            </div>
                            <span class="fw-bold">${title}</span>
                        </div>
                    </td>
                    <td>
                        <span class="badge" style="background-color: ${badgeBg}; color: ${badgeColor}; border: 1px solid ${badgeColor}33;">
                            ${category}
                        </span>
                    </td>
                    <td>0 Öğrenci</td>
                    <td><span class="badge badge-subtle-success rounded-pill px-3 py-2">Aktif</span></td>
                    <td class="text-end">
                        <button class="btn-icon me-2"><i class="bi bi-pencil-fill"></i></button>
                        <button class="btn-icon btn-icon-danger delete-btn"><i class="bi bi-trash-fill"></i></button>
                    </td>
                `;

                // Add to table with subtle animation
                tr.style.opacity = '0';
                tr.style.transform = 'translateY(-10px)';
                tr.style.transition = 'all 0.3s ease';
                courseTableBody.prepend(tr);

                setTimeout(() => {
                    tr.style.opacity = '1';
                    tr.style.transform = 'translateY(0)';
                }, 50);

                // Reset and Close Modal
                addCourseForm.reset();
                modalInstance.hide();
            });

            // Delegate Delete Event
            courseTableBody.addEventListener('click', (e) => {
                const deleteBtn = e.target.closest('.delete-btn');
                if (deleteBtn) {
                    const row = deleteBtn.closest('tr');
                    row.style.opacity = '0';
                    row.style.transform = 'translateX(20px)';
                    row.style.transition = 'all 0.3s ease';
                    setTimeout(() => row.remove(), 300);
                }
            });
        });
    </script>
</body>
</html>
