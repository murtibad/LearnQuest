@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <script src="~/js/site.js"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - LearnQuest</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%234F46E5'><path d='M8 2.223 1 5.373v.13l7 3.15 7-3.15v-.13L8 2.223zm0 6.5-6-2.7v5.47c0 1.25.968 2.378 2.802 2.92C6.183 14.836 7.151 15 8 15c.849 0 1.817-.164 3.198-.587 1.834-.542 2.802-1.67 2.802-2.92V6.023l-6 2.7z'/></svg>">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body { display: flex; align-items: center; justify-content: center; height: 100vh; }
        @@keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        .auth-card { animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 24px; padding: 40px; width: 100%; max-width: 450px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); transition: all 0.3s ease; }
        .form-control { background-color: var(--bg-main); border: 1px solid var(--border-color); color: var(--text-main); border-radius: 12px; padding: 12px 16px; transition: all 0.3s ease; }
        .form-control:focus { background-color: var(--bg-main); border-color: #4F46E5; color: var(--text-main); box-shadow: 0 0 0 3px rgba(79,70,229,0.2); }
        .form-control::placeholder { color: var(--text-muted); }
        .btn-primary-custom { background-color: #4F46E5; color: white; border-radius: 12px; padding: 12px; font-weight: 600; border: none; width: 100%; transition: all 0.3s; }
        .btn-primary-custom:hover { background-color: #4338ca; transform: translateY(-2px); }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="text-center mb-4">
            <a href="/" class="text-decoration-none d-flex align-items-center justify-content-center gap-2 mb-4 w-100">
                <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
                <span class="fs-3 fw-bold" style="color: var(--text-main); letter-spacing: -0.5px;">LearnQuest</span>
            </a>
            <h4 class="fw-bold">Þifreni mi Unuttun?</h4>
            <p class="text-muted-custom">E-posta adresini gir, sana bir sýfýrlama baðlantýsý gönderelim.</p>
        </div>
        <form action="/Auth/Login" method="get">
            <div class="mb-4">
                <label class="form-label fw-medium text-muted-custom small">E-posta</label>
                <input type="email" class="form-control" placeholder="ogrenci@subu.edu.tr" required>
            </div>
            <button type="submit" class="btn-primary-custom mb-4">Sýfýrlama Linki Gönder</button>
            <div class="text-center">
                <a href="/Auth/Login" class="text-decoration-none fw-bold small" style="color: #4F46E5;">
                    <i class="bi bi-arrow-left me-1"></i> Giriþ Sayfasýna Dön
                </a>
            </div>
        </form>
    </div>
</body>
</html>




