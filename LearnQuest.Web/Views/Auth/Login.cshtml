@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap - LearnQuest</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { 
            background-color: #0b1120; /* Dark, consistent background */
            font-family: 'Inter', sans-serif; 
            height: 100vh; 
            display: flex; 
            align-items: center; 
            justify-content: center;
            color: #ffffff;
        }
        .auth-card { 
            background: #1e293b; /* Slightly lighter card background */
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 24px; 
            padding: 40px; 
            width: 100%; 
            max-width: 450px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.2); 
        }
        .form-control { 
            background-color: #0f172a; 
            border: 1px solid rgba(255,255,255,0.1); 
            color: white;
            border-radius: 12px; 
            padding: 12px 16px; 
        }
        .form-control:focus { 
            background-color: #0f172a; 
            border-color: #4F46E5; 
            color: white;
            box-shadow: 0 0 0 3px rgba(79,70,229,0.2); 
        }
        .form-control::placeholder {
            color: #64748b;
        }
        .btn-primary-custom { 
            background-color: #4F46E5; 
            color: white; 
            border-radius: 12px; 
            padding: 12px; 
            font-weight: 600; 
            border: none; 
            width: 100%; 
            transition: all 0.3s; 
        }
        .btn-primary-custom:hover { 
            background-color: #4338ca; 
            transform: translateY(-2px); 
        }
        .text-muted-custom {
            color: #cbd5e1 !important;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="text-center mb-4">
            <a href="/" class="text-decoration-none d-inline-flex align-items-center gap-2 mb-3">
                <img src="~/images/logo.jpg" alt="Logo" style="height: 40px; width: 40px; border-radius: 50%;">
                <span class="fs-4 fw-bold text-white">LearnQuest</span>
            </a>
            <h4 class="fw-bold">Tekrar Hoş Geldin!</h4>
            <p class="text-muted-custom">Macerana kaldığın yerden devam et.</p>
        </div>
        <form action="/Dashboard" method="get">
            <div class="mb-3">
                <label class="form-label fw-medium text-muted-custom small">E-posta</label>
                <input type="email" class="form-control" placeholder="ogrenci@subu.edu.tr" required>
            </div>
            <div class="mb-4">
                <div class="d-flex justify-content-between">
                    <label class="form-label fw-medium text-muted-custom small">Şifre</label>
                    <a href="/Auth/ForgotPassword" class="text-decoration-none small" style="color: #818cf8;">Şifremi Unuttum</a>
                </div>
                <input type="password" class="form-control" placeholder="••••••••" required>
            </div>
            <button type="submit" class="btn-primary-custom mb-3">Giriş Yap</button>
            <p class="text-center text-muted-custom small mb-0">
                Hesabın yok mu? <a href="/Auth/Register" class="text-decoration-none fw-bold" style="color: #818cf8;">Kayıt Ol</a>
            </p>
        </form>
    </div>
</body>
</html>