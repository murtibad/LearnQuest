@{
    ViewData["Title"] = "Courses";
}

<!-- Main container for Courses page -->
<div class="container-fluid py-4">
    
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold">
                <a href="/Dashboard" class="text-dark text-decoration-none me-2">
                    <i class="bi bi-arrow-left fs-4"></i>
                </a>
                Dersler
            </h2>
            <p class="text-muted ms-5">Kategorilere göre derslerini seç ve öğrenmeye başla.</p>
        </div>
    </div>

    <!-- Search and Filters Section -->
    <div class="row mb-5 ms-4">
        <div class="col-md-12">
            <!-- Search Bar -->
            <div class="input-group mb-4" style="max-width: 400px;">
                <span class="input-group-text bg-transparent border-end-0 rounded-start-pill" id="search-icon">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" class="form-control border-start-0 rounded-end-pill shadow-none" placeholder="Ders ara..." aria-describedby="search-icon">
            </div>

            <!-- Category Filter Badges -->
            <div class="d-flex gap-3">
                <a href="#" class="btn btn-primary rounded-pill px-4">Tümü</a>
                <a href="#" class="btn btn-light text-muted rounded-pill px-4 shadow-sm border">Programlama</a>
                <a href="#" class="btn btn-light text-muted rounded-pill px-4 shadow-sm border">Veritabanı</a>
                <a href="#" class="btn btn-light text-muted rounded-pill px-4 shadow-sm border">Web</a>
                <a href="#" class="btn btn-light text-muted rounded-pill px-4 shadow-sm border">Diğer</a>
            </div>
        </div>
    </div>

    <!-- Course Cards Grid (Bento Box) -->
    <div class="row g-4 ms-4">
        
        <!-- Course Item: C# Fundamentals -->
        <div class="col-md-3">
            <div class="bento-card position-relative">
                <div class="bg-primary bg-opacity-10 p-3 rounded-4 mb-3 d-inline-block">
                    <i class="bi bi-code-slash fs-2 text-primary"></i>
                </div>
                <h5 class="fw-bold mb-1">C# Temelleri</h5>
                <p class="text-muted small mb-4">%80 tamamlandı</p>
                
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: 80%;"></div>
                </div>
                <!-- Navigation arrow indicator -->
                <i class="bi bi-chevron-right position-absolute bottom-0 end-0 m-4 text-muted"></i>
            </div>
        </div>

        <!-- Course Item: ASP.NET MVC -->
        <div class="col-md-3">
            <div class="bento-card position-relative">
                <div style="background-color: var(--purple-badge); color: white;" class="p-3 rounded-4 mb-3 d-inline-block opacity-75">
                    <i class="bi bi-braces-asterisk fs-2"></i>
                </div>
                <h5 class="fw-bold mb-1">ASP.NET MVC</h5>
                <p class="text-muted small mb-4">%45 tamamlandı</p>
                
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar" style="width: 45%; background-color: var(--purple-badge);" role="progressbar"></div>
                </div>
                <i class="bi bi-chevron-right position-absolute bottom-0 end-0 m-4 text-muted"></i>
            </div>
        </div>

        <!-- Course Item: SQL Database -->
        <div class="col-md-3">
            <div class="bento-card position-relative">
                <div class="bg-success bg-opacity-10 p-3 rounded-4 mb-3 d-inline-block">
                    <i class="bi bi-database fs-2 text-success"></i>
                </div>
                <h5 class="fw-bold mb-1">SQL Veritabanı</h5>
                <p class="text-muted small mb-4">%70 tamamlandı</p>
                
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: 70%;"></div>
                </div>
                <i class="bi bi-chevron-right position-absolute bottom-0 end-0 m-4 text-muted"></i>
            </div>
        </div>

    </div>
</div>