@{
    ViewData["Title"] = "Dersler";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    
    <!-- Page Header -->
    <div class="mb-4">
        <div class="d-flex align-items-center gap-3 mb-1">
            <a href="/Dashboard" class="text-decoration-none" style="color: var(--text-main);">
                <i class="bi bi-arrow-left fs-4"></i>
            </a>
            <h2 class="fw-bold mb-0" style="color: var(--text-main);">Dersler</h2>
        </div>
        <p class="text-muted-custom ms-5">Kategorilere göre derslerini seç ve öğrenmeye başla.</p>
    </div>

    <!-- Search and Filters -->
    <div class="mb-5">
        <!-- Search Bar -->
        <div class="input-group mb-4" style="max-width: 400px;">
            <span class="input-group-text border-end-0 rounded-start-pill">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" id="searchInput" class="form-control border-start-0 rounded-end-pill shadow-none" placeholder="Ders ara..." onkeyup="filterCourses()" style="background-color: var(--bg-main); border-color: var(--border-color); color: var(--text-main);">
        </div>

        <!-- Category Filters -->
        <div class="d-flex gap-2 flex-wrap" id="categoryFilters">
            <button class="btn rounded-pill px-4 py-2 fw-semibold text-white filter-btn" data-filter="all" style="background-color: #4F46E5;">Tümü</button>
            <button class="btn rounded-pill px-4 py-2 fw-semibold filter-btn" data-filter="programlama" style="background-color: var(--card-bg); color: var(--text-muted); border: 1px solid var(--border-color);">Programlama</button>
            <button class="btn rounded-pill px-4 py-2 fw-semibold filter-btn" data-filter="veritabani" style="background-color: var(--card-bg); color: var(--text-muted); border: 1px solid var(--border-color);">Veritabanı</button>
            <button class="btn rounded-pill px-4 py-2 fw-semibold filter-btn" data-filter="web" style="background-color: var(--card-bg); color: var(--text-muted); border: 1px solid var(--border-color);">Web</button>
            <button class="btn rounded-pill px-4 py-2 fw-semibold filter-btn" data-filter="diger" style="background-color: var(--card-bg); color: var(--text-muted); border: 1px solid var(--border-color);">Diğer</button>
        </div>
    </div>

    <!-- Course Cards Grid -->
    <div class="row g-4">
        
        <!-- C# Temelleri -->`n        <div class="col-lg-4 col-md-6 course-item" data-category="programlama">
            <div class="bento-card position-relative h-100">
                <div class="d-inline-flex align-items-center justify-content-center rounded-4 mb-3" style="width: 56px; height: 56px; background-color: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                    <i class="bi bi-code-slash fs-3"></i>
                </div>
                <h5 class="fw-bold mb-1 course-title" style="color: var(--text-main);">C# Temelleri</h5>
                <p class="text-muted-custom small mb-3">%80 tamamlandı</p>
                <div class="progress" style="height: 6px; border-radius: 6px;">
                    <div class="progress-bar rounded-pill" role="progressbar" style="width: 80%; background-color: #3b82f6;"></div>
                </div>
                <i class="bi bi-chevron-right position-absolute bottom-0 end-0 m-4 text-muted-custom"></i>
            </div>
        </div>

        <!-- ASP.NET MVC -->`n        <div class="col-lg-4 col-md-6 course-item" data-category="web">
            <div class="bento-card position-relative h-100">
                <div class="d-inline-flex align-items-center justify-content-center rounded-4 mb-3" style="width: 56px; height: 56px; background-color: rgba(139, 92, 246, 0.1); color: var(--purple-badge);">
                    <i class="bi bi-braces-asterisk fs-3"></i>
                </div>
                <h5 class="fw-bold mb-1 course-title" style="color: var(--text-main);">ASP.NET MVC</h5>
                <p class="text-muted-custom small mb-3">%45 tamamlandı</p>
                <div class="progress" style="height: 6px; border-radius: 6px;">
                    <div class="progress-bar rounded-pill" role="progressbar" style="width: 45%; background-color: var(--purple-badge);"></div>
