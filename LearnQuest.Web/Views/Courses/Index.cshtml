        <div class="col-lg-4 col-md-6">
            <div class="bento-card position-relative h-100">
                <div class="d-inline-flex align-items-center justify-content-center rounded-4 mb-3" style="width: 56px; height: 56px; background-color: rgba(16, 185, 129, 0.1); color: #10b981;">
                    <i class="bi bi-database fs-3"></i>
                </div>
                <h5 class="fw-bold mb-1 course-title" style="color: var(--text-main);">SQL Veritabanı</h5>
                <p class="text-muted-custom small mb-3">%70 tamamlandı</p>
                <div class="progress" style="height: 6px; border-radius: 6px;">
                    <div class="progress-bar rounded-pill" role="progressbar" style="width: 70%; background-color: #10b981;"></div>
                </div>
                <i class="bi bi-chevron-right position-absolute bottom-0 end-0 m-4 text-muted-custom"></i>
            </div>
        </div>

        <!-- JavaScript -->`n        <div class="col-lg-4 col-md-6 course-item" data-category="web">
            <div class="bento-card position-relative h-100">
                <div class="d-inline-flex align-items-center justify-content-center rounded-4 mb-3" style="width: 56px; height: 56px; background-color: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                    <i class="bi bi-filetype-js fs-3"></i>
                </div>
                <h5 class="fw-bold mb-1 course-title" style="color: var(--text-main);">JavaScript</h5>
                <p class="text-muted-custom small mb-3">%30 tamamlandı</p>
                <div class="progress" style="height: 6px; border-radius: 6px;">
                    <div class="progress-bar rounded-pill" role="progressbar" style="width: 30%; background-color: #f59e0b;"></div>
                </div>
                <i class="bi bi-chevron-right position-absolute bottom-0 end-0 m-4 text-muted-custom"></i>
            </div>
        </div>

        <!-- HTML & CSS -->
        <div class="col-lg-4 col-md-6">
            <div class="bento-card position-relative h-100">
                <div class="d-inline-flex align-items-center justify-content-center rounded-4 mb-3" style="width: 56px; height: 56px; background-color: rgba(239, 68, 68, 0.1); color: #ef4444;">
                    <i class="bi bi-filetype-html fs-3"></i>
                </div>
                <h5 class="fw-bold mb-1 course-title" style="color: var(--text-main);">HTML & CSS</h5>
                <p class="text-muted-custom small mb-3">%100 tamamlandı</p>
                <div class="progress" style="height: 6px; border-radius: 6px;">
                    <div class="progress-bar rounded-pill" role="progressbar" style="width: 100%; background-color: #ef4444;"></div>
                </div>
                <i class="bi bi-chevron-right position-absolute bottom-0 end-0 m-4 text-muted-custom"></i>
            </div>
        </div>

        <!-- OOP ve Tasarım Desenleri -->
        <div class="col-lg-4 col-md-6">
            <div class="bento-card position-relative h-100">
                <div class="d-inline-flex align-items-center justify-content-center rounded-4 mb-3" style="width: 56px; height: 56px; background-color: rgba(6, 182, 212, 0.1); color: #06b6d4;">
                    <i class="bi bi-diagram-3-fill fs-3"></i>
                </div>
                <h5 class="fw-bold mb-1 course-title" style="color: var(--text-main);">OOP ve Tasarım Desenleri</h5>
                <p class="text-muted-custom small mb-3">%20 tamamlandı</p>
                <div class="progress" style="height: 6px; border-radius: 6px;">
                    <div class="progress-bar rounded-pill" role="progressbar" style="width: 20%; background-color: #06b6d4;"></div>
                </div>
                <i class="bi bi-chevron-right position-absolute bottom-0 end-0 m-4 text-muted-custom"></i>
            </div>
        </div>

    </div>
</div>
</div>
@section Scripts {
    <script>
        let currentFilter = 'all';

        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                document.querySelectorAll('.filter-btn').forEach(b => {
                    b.style.backgroundColor = 'var(--card-bg)';
                    b.style.color = 'var(--text-muted)';
                    b.classList.remove('text-white');
                });
                
                const target = e.target;
                target.style.backgroundColor = '#4F46E5';
                target.style.color = 'white';
                target.classList.add('text-white');
                
                currentFilter = target.getAttribute('data-filter');
                filterCourses();
            });
        });

        function filterCourses() {
            const searchQuery = document.getElementById('searchInput').value.toLowerCase();
            const items = document.querySelectorAll('.course-item');
            
            items.forEach(item => {
                const category = item.getAttribute('data-category');
                const title = item.querySelector('.course-title').innerText.toLowerCase();
                
                const matchesCategory = (currentFilter === 'all' || category === currentFilter);
                const matchesSearch = title.includes(searchQuery);
                
                if (matchesCategory && matchesSearch) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }
    </script>
}
