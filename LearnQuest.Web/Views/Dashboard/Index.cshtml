@{
    ViewData["Title"] = "Dashboard";
    // Bu sayfa için standart Layout'u kullanacağız, sol menü ve üst barı oradan alacak
}

<div class="container-fluid py-4">
    <!-- Karşılama Alanı -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold">Merhaba, Öğrenci! 👋</h2>
            <p class="text-muted">Bugünün hedefi: 2 ders tamamla ve 1 sınav yap!</p>
        </div>
    </div>

    <!-- İstatistik Kartları (Bento Box) -->
    <div class="row g-4 mb-4">
        <!-- Toplam Ders -->
        <div class="col-md-3">
            <div class="bento-card d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                    <i class="bi bi-book fs-3 text-primary"></i>
                </div>
                <div>
                    <p class="text-muted mb-0 small">Toplam Ders</p>
                    <h3 class="fw-bold mb-0">12</h3>
                </div>
            </div>
        </div>

        <!-- Tamamlanan Ders -->
        <div class="col-md-3">
            <div class="bento-card d-flex align-items-center gap-3">
                <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                    <i class="bi bi-check-circle fs-3 text-success"></i>
                </div>
                <div>
                    <p class="text-muted mb-0 small">Tamamlanan</p>
                    <h3 class="fw-bold mb-0">8</h3>
                </div>
            </div>
        </div>

        <!-- Başarı Oranı -->
        <div class="col-md-3">
            <div class="bento-card d-flex align-items-center gap-3">
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                    <i class="bi bi-star-fill fs-3 text-warning"></i>
                </div>
                <div>
                    <p class="text-muted mb-0 small">Başarı Oranı</p>
                    <h3 class="fw-bold mb-0">%85</h3>
                </div>
            </div>
        </div>

        <!-- Toplam Puan (XP) -->
        <div class="col-md-3">
            <div class="bento-card d-flex align-items-center gap-3">
                <div style="background-color: var(--purple-badge); color: white;" class="p-3 rounded-circle">
                    <i class="bi bi-trophy fs-3"></i>
                </div>
                <div>
                    <p class="text-muted mb-0 small">Toplam Puan</p>
                    <h3 class="fw-bold mb-0">4.320</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Alt Bölüm: Seviye ve Aktiviteler -->
    <div class="row g-4">
        <!-- Seviye Kartı -->
        <div class="col-md-6">
            <div class="bento-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <div style="background-color: var(--purple-badge); color: white;" class="p-3 rounded-3 fw-bold fs-4">
                            5
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Seviye 5</h5>
                            <small class="text-muted">320 / 600 XP</small>
                        </div>
                    </div>
                    <span class="text-muted small">Seviye 6</span>
                </div>
                <!-- Progress Bar -->
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar" role="progressbar" style="width: 53%; background-color: var(--primary-blue);" aria-valuenow="53" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>

        <!-- Hızlı Erişim (Günün Görevi) -->
        <div class="col-md-6">
            <div class="bento-card bg-primary text-white">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <i class="bi bi-bullseye fs-2"></i>
                    <div>
                        <h5 class="fw-bold mb-0">Bugünün Görevi</h5>
                        <p class="mb-0 small text-white-50">3 soruluk mini sınavı tamamla.</p>
                    </div>
                </div>
                <button class="btn btn-light text-primary fw-bold w-100 rounded-pill">Başla</button>
            </div>
        </div>
    </div>
</div>  