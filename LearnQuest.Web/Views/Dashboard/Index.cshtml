@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
}

<style>
    .tumunu-gor-link { transition: opacity 0.2s; }
    .tumunu-gor-link:hover { opacity: 0.8; }
</style>

<div class="container-fluid py-4">
    
    <!-- Welcome Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-5">
        <div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2" style="color: var(--text-main);">
                Merhaba, @* Model.FirstName *@Ahmet! 
                <span style="font-size: 1.5rem;">👋</span>
            </h2>
            <p class="text-muted-custom mb-0">Bugünün hedefi: 2 ders tamamla ve 1 sınav yap!</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="dropdown">
                <button class="btn btn-link text-decoration-none position-relative p-2 text-muted-custom" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Bildirimler">
                    <i class="bi bi-bell fs-5"></i>
                    <span class="position-absolute bg-danger border border-2 border-white rounded-circle" style="top: 4px; right: 4px; width: 10px; height: 10px;"></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-lg notification-dropdown" aria-labelledby="notificationDropdown">
                    <li class="px-3 py-2 border-bottom border-secondary d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold" style="color: var(--text-main);">Bildirimler</h6>
                        <span class="badge bg-primary rounded-pill">2 Yeni</span>
                    </li>
                    <li>
                        <a class="dropdown-item py-3 d-flex align-items-start gap-3" href="#" @* TODO: needs a route *@>
                            <div class="p-2 rounded-circle" style="background-color: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                                <i class="bi bi-trophy-fill"></i>
                            </div>
                            <div>
                                <strong class="d-block mb-1" style="color: var(--text-main);">Seri Katili rozeti kazandın!</strong>
                                <span class="small text-muted-custom">3 gün üst üste giriş yaptın.</span>
                            </div>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-3 d-flex align-items-start gap-3 border-top border-secondary" href="#" @* TODO: needs a route *@>
                            <div class="p-2 rounded-circle" style="background-color: rgba(79, 70, 229, 0.1); color: #4F46E5;">
                                <i class="bi bi-book-half"></i>
                            </div>
                            <div>
                                <strong class="d-block mb-1" style="color: var(--text-main);">C# dersi güncellendi.</strong>
                                <span class="small text-muted-custom">Yeni bir video eklendi.</span>
                            </div>
                        </a>
                    </li>
                    <li class="px-3 py-2 border-top border-secondary text-center">
                        <a href="#" @* TODO: needs a route *@ class="text-decoration-none small fw-bold tumunu-gor-link" style="color: #4F46E5;">Tümünü Gör</a>
                    </li>
                </ul>
            </div>
            
            <a href="/Dashboard/Profile" class="text-decoration-none d-flex align-items-center gap-2 rounded-pill p-1 pe-3 user-profile-btn" style="background-color: var(--card-bg); border: 1px solid var(--border-color); transition: all 0.2s;">
                <div class="text-white rounded-circle d-flex justify-content-center align-items-center" style="width: 36px; height: 36px; background-color: var(--primary); font-weight: 700; font-size: 0.85rem;">
                    @* Model.Initials *@AY
                </div>
                <div class="d-flex flex-column lh-1">
                    <span class="fw-bold small" style="color: var(--text-main);">@* Model.FullName *@Ahmet Yılmaz</span>
                    <span class="mt-1" style="color: var(--primary); font-size: 0.72rem; font-weight: 600;" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Sonraki seviyeye 150 XP kaldı!">@* Model.Level *@Seviye 5</span>
                </div>
            </a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-4 fade-in-up">
        <div class="col-sm-6 col-xl-3">
            <div class="bento-card h-100 skeleton-item d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 56px; height: 56px; background-color: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                    <i class="bi bi-book-half fs-3"></i>
                </div>
                <div>
                    <p class="mb-0 small fw-medium text-muted-custom">Toplam Ders</p>
                    <h3 class="fw-bold mb-0" style="color: var(--text-main);">@* Model.TotalCourses *@12</h3>
                </div>
            </div>
        </div>
        
        <div class="col-sm-6 col-xl-3">
            <div class="bento-card h-100 skeleton-item d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 56px; height: 56px; background-color: rgba(16, 185, 129, 0.1); color: #10b981;">
                    <i class="bi bi-check-circle-fill fs-3"></i>
                </div>
                <div>
                    <p class="mb-0 small fw-medium text-muted-custom">Tamamlanan Ders</p>
                    <h3 class="fw-bold mb-0" style="color: var(--text-main);">@* Model.CompletedCourses *@8</h3>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="bento-card h-100 skeleton-item d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 56px; height: 56px; background-color: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                    <i class="bi bi-star-fill fs-3"></i>
                </div>
                <div>
                    <p class="mb-0 small fw-medium text-muted-custom">Başarı Oranı</p>
                    <h3 class="fw-bold mb-0" style="color: var(--text-main);">@* Model.SuccessRate *@%85</h3>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="bento-card h-100 skeleton-item d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 56px; height: 56px; background-color: rgba(139, 92, 246, 0.1); color: var(--purple-badge);">
                    <i class="bi bi-trophy-fill fs-3"></i>
                </div>
                <div>
                    <p class="mb-0 small fw-medium text-muted-custom">Toplam Puan</p>
                    <h3 class="fw-bold mb-0" style="color: var(--text-main);">@* Model.TotalXP *@4.320</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Progress and Quests -->
    <div class="row g-4 mb-4 fade-in-up fade-in-up-delay-1">
        <div class="col-lg-7">
            <div class="bento-card h-100 skeleton-item p-4 p-lg-5 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0" style="color: var(--text-main);">Seviye İlerlemesi</h5>
                        <span class="badge rounded-pill px-3 py-1 fw-semibold" style="background-color: var(--hover-bg); color: var(--primary); font-size: 0.8rem;">XP Durumu</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-end mb-4">
                        <div class="d-flex align-items-center gap-4">
                            <div class="position-relative d-inline-flex align-items-center justify-content-center">
                                <i class="bi bi-shield-fill" style="font-size: 4.75rem; color: var(--primary); line-height: 1;"></i>
                                <span class="position-absolute top-50 start-50 translate-middle text-white fw-bold fs-4">@* Model.Level *@5</span>
                            </div>
                            <div>
                                <h4 class="fw-bold mb-1" style="color: var(--text-main);">@* Model.LevelName *@Seviye 5</h4>
                                <p class="mb-0 text-muted-custom fw-medium">@* Model.CurrentXP / Model.NextLevelXP *@320 / 600 XP</p>
                            </div>
                        </div>
                        <span class="fw-semibold text-muted-custom">Seviye 6</span>
                    </div>
                </div>
                <div>
                    <div class="progress" style="height: 12px; border-radius: 10px;">
                        <div class="progress-bar rounded-pill" role="progressbar" style="width: 53%; background-color: var(--primary);" aria-valuenow="53" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="d-flex justify-content-between text-muted-custom small mt-2">
                        <span>%53 Tamamlandı</span>
                        <span>280 XP kaldı</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="bento-card skeleton-item border-0 text-white h-100 p-4 p-lg-5 d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #4F46E5 0%, #3b82f6 100%);">
                <div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px;">
                            <i class="bi bi-bullseye fs-3 text-white"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1 text-white">Bugünün Görevi</h4>
                            <p class="mb-0 text-white text-opacity-75 small">@* Model.DailyQuest.Description *@3 soruluk mini sınavı tamamla.</p>
                        </div>
                    </div>
                    <p class="text-white text-opacity-80 small mb-3">
                        Günün görevini başarıyla bitirerek ekstra deneyim puanı topla ve sıralamada öne geç!
                    </p>
                    <div class="mb-4">
                        <div class="d-flex justify-content-between text-white text-opacity-75 small mb-1">
                            <span>İlerleme</span>
                            <span class="fw-bold">@* Model.DailyQuest.Progress *@1 / 3</span>
                        </div>
                        <div class="progress bg-white bg-opacity-25" style="height: 6px; border-radius: 6px;">
                            <div class="progress-bar bg-white rounded-pill" style="width: 33%;"></div>
                        </div>
                    </div>
                </div>
                <a href="/Dashboard/Quiz" class="btn btn-light rounded-pill w-100 py-3 fw-bold shadow-sm text-decoration-none text-center" style="color: #4F46E5;">Başla</a>
            </div>
        </div>
    </div>

    <!-- Son Aktiviteler -->
    <!-- Partial: _RecentActivities -->
    <div class="row g-4 fade-in-up fade-in-up-delay-2">
        <div class="col-12">
            <div class="bento-card skeleton-item">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0" style="color: var(--text-main);">Son Aktiviteler</h5>
                    <span class="badge rounded-pill px-3 py-1 fw-semibold" style="background-color: var(--hover-bg); color: var(--primary); font-size: 0.75rem;">Son Hareketler</span>
                </div>
                <div class="activity-list">
                    <div class="activity-item">
                        <div class="activity-icon" style="background-color: rgba(16, 185, 129, 0.12); color: #10b981;">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                        <div class="flex-grow-1 d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="fw-semibold" style="color: var(--text-main);">Web Geliştirme dersini tamamladın</span>
                                <span class="badge rounded-pill fw-semibold px-2 py-1" style="background-color: rgba(16, 185, 129, 0.15); color: #10b981; font-size: 0.75rem;">+100 XP</span>
                            </div>
                            <span class="text-muted-custom small">2 saat önce</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon" style="background-color: rgba(59, 130, 246, 0.12); color: #3b82f6;">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </div>
                        <div class="flex-grow-1 d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="fw-semibold" style="color: var(--text-main);">Doğru cevap: JavaScript nedir?</span>
                                <span class="badge rounded-pill fw-semibold px-2 py-1" style="background-color: rgba(59, 130, 246, 0.15); color: #3b82f6; font-size: 0.75rem;">+50 XP</span>
                            </div>
                            <span class="text-muted-custom small">4 saat önce</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon" style="background-color: rgba(139, 92, 246, 0.12); color: var(--purple-badge);">
                            <i class="bi bi-trophy-fill"></i>
                        </div>
                        <div class="flex-grow-1 d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="fw-semibold" style="color: var(--text-main);">Yeni bir rozet kazandın: "Başlangıç"</span>
                            </div>
                            <span class="text-muted-custom small">1 gün önce</span>
                        </div>
                    </div>
                </div>
                <div class="text-center pt-3 mt-1">
                    <a href="/Dashboard/Profile" class="text-decoration-none fw-semibold small d-inline-flex align-items-center gap-1 tumunu-gor-link" style="color: var(--primary);">
                        <span>Tümünü Gör</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            setTimeout(() => {
                if (window.Toast) {
                    window.Toast.fire({ icon: "info", title: "Tekrar hoş geldin, Ahmet!" });
                }
            }, 1000);
        });
    </script>
}