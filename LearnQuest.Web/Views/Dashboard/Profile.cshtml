@{
    Layout = "_Layout";
    ViewData["Title"] = "Profil";
}

<div class="container-fluid py-4">

    <!-- Profile Header Section -->
    <div class="bento-card skeleton-item mb-4" style="border-radius: 24px;">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4 mb-4">
            <div class="d-flex align-items-center gap-4 flex-wrap flex-sm-nowrap">
                <!-- Large User Avatar Circle -->
                <div class="position-relative flex-shrink-0">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm"
                         style="width: 88px; height: 88px; background: linear-gradient(135deg, #4F46E5 0%, #3b82f6 100%); font-size: 2rem; font-weight: 700; border: 4px solid var(--card-bg); box-shadow: 0 4px 14px rgba(79, 70, 229, 0.3);">
                        AY
                    </div>
                    <span class="position-absolute bottom-0 end-0 p-2 bg-success border border-2 border-white rounded-circle" title="Çevrimiçi"></span>
                </div>

                <!-- User Details -->
                <div>
                    <div class="d-flex align-items-center gap-3 flex-wrap mb-1">
                        <h2 class="fw-bold mb-0" style="color: var(--text-main);">@* Model.FullName *@Ahmet Yılmaz</h2>
                        <!-- Level Badge -->
                        <span class="badge rounded-pill" style="background-color: var(--hover-bg); color: var(--primary); font-size: 0.85rem; padding: 6px 14px; font-weight: 600;">
                            <i class="bi bi-shield-fill me-1"></i> Seviye 5 · 320 / 600 XP
                        </span>
                    </div>
                    <p class="text-muted-custom mb-0 d-flex align-items-center gap-2 flex-wrap">
                        <span><i class="bi bi-envelope me-1"></i> @* Model.Email *@ahmet.yilmaz@ogrenci.subu.edu.tr</span>
                        <span class="d-none d-sm-inline">•</span>
                        <span><i class="bi bi-mortarboard me-1"></i> Yazılım Geliştirici</span>
                    </p>
                </div>
            </div>

            <!-- Gamification Streak Badge -->
            <div class="d-flex align-items-center gap-2">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill" style="background-color: var(--hover-bg); border: 1px solid var(--border-color);">
                    <i class="bi bi-fire text-danger fs-5"></i>
                    <span class="small fw-bold" style="color: var(--text-main);">7 Günlük Seri 🔥</span>
                </div>
            </div>
        </div>

        <!-- XP Progress Bar -->
        <div class="p-3 rounded-4" style="background-color: var(--bg-main); border: 1px solid var(--border-color);">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small fw-bold" style="color: var(--text-main);">
                    <i class="bi bi-stars text-warning me-1"></i> Seviye İlerlemesi
                </span>
                <span class="small text-muted-custom fw-semibold">320 / 600 XP (%53)</span>
            </div>
            <div class="progress" style="height: 12px; border-radius: 10px; background-color: var(--border-color);">
                <div class="progress-bar rounded-pill" role="progressbar" 
                     style="width: 53.3%; background: linear-gradient(90deg, #4F46E5 0%, #3b82f6 100%); transition: width 0.8s ease;" 
                     aria-valuenow="53" aria-valuemin="0" aria-valuemax="100">
                </div>
            </div>
            <div class="d-flex justify-content-between mt-2">
                <span class="small text-muted-custom">Seviye 5 (Maceracı)</span>
                <span class="small text-muted-custom">Sonraki: Seviye 6 (Kıdemli)</span>
            </div>
        </div>
    </div>

    <!-- Tab Navigation -->
    <div class="d-flex align-items-center gap-2 mb-4 p-1 rounded-4" style="background-color: var(--card-bg); border: 1px solid var(--border-color); width: fit-content;">
        <button type="button" class="tab-custom active" id="tabBtnStats" onclick="selectTab('stats')">
            <i class="bi bi-bar-chart-fill me-1"></i> İstatistikler
        </button>
        <button type="button" class="tab-custom" id="tabBtnBadges" onclick="selectTab('badges')">
            <i class="bi bi-award-fill me-1"></i> Rozetler
        </button>
        <button type="button" class="tab-custom" id="tabBtnAchievements" onclick="selectTab('achievements')">
            <i class="bi bi-trophy-fill me-1"></i> Başarılar
        </button>
    </div>

    <!-- Tab Content: İstatistikler (Visible) -->
    <div id="istatistiklerTabContent">
        <!-- 4 Stat Cards in a Row -->
        <div class="row g-4 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="bento-card skeleton-item h-100 shadow-sm" style="border-radius: 20px;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" 
                             style="width: 60px; height: 60px; background-color: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                            <i class="bi bi-book-half fs-3"></i>
                        </div>
                        <div>
                            <p class="mb-0 small fw-medium text-muted-custom">Toplam Ders</p>
                            <h3 class="fw-bold mb-0" style="color: var(--text-main);">@* Model.TotalCourses *@12</h3>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="bento-card skeleton-item h-100 shadow-sm" style="border-radius: 20px;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" 
                             style="width: 60px; height: 60px; background-color: rgba(16, 185, 129, 0.1); color: #10b981;">
                            <i class="bi bi-check-circle fs-3"></i>
                        </div>
                        <div>
                            <p class="mb-0 small fw-medium text-muted-custom">Tamamlanan Ders</p>
                            <h3 class="fw-bold mb-0" style="color: var(--text-main);">@* Model.CompletedCourses *@8</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="bento-card skeleton-item h-100 shadow-sm" style="border-radius: 20px;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" 
                             style="width: 60px; height: 60px; background-color: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                            <i class="bi bi-star-fill fs-3"></i>
                        </div>
                        <div>
                            <p class="mb-0 small fw-medium text-muted-custom">Başarı Oranı</p>
                            <h3 class="fw-bold mb-0" style="color: var(--text-main);">@* Model.SuccessRate *@%85</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="bento-card skeleton-item h-100 shadow-sm" style="border-radius: 20px;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" 
                             style="width: 60px; height: 60px; background-color: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                            <i class="bi bi-trophy-fill fs-3"></i>
                        </div>
                        <div>
                            <p class="mb-0 small fw-medium text-muted-custom">Toplam Puan</p>
                            <h3 class="fw-bold mb-0" style="color: var(--text-main);">@* Model.TotalXP *@4.320</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 'Son 7 Gün' Bar Chart Section -->
        <div class="bento-card skeleton-item mb-5" style="border-radius: 24px;">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-1" style="color: var(--text-main);">Son 7 Gün</h5>
                    <p class="text-muted-custom small mb-0">Haftalık ders ve aktivite tamamlama oranları</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rounded-pill px-3 py-2" style="background-color: var(--hover-bg); color: var(--primary); font-weight: 600;">
                        <i class="bi bi-graph-up-arrow me-1"></i> Ortalama: %61
                    </span>
                </div>
            </div>

            <!-- CSS Bar Chart (7 days) -->
            <div class="d-flex align-items-end justify-content-between gap-2 gap-md-4 pt-3 px-2" style="min-height: 200px;">
                <!-- Pazartesi: 60% -->
                <div class="d-flex flex-column align-items-center flex-fill">
                    <span class="small fw-bold mb-2" style="color: var(--text-main); font-size: 0.75rem;">%60</span>
                    <div class="stat-bar w-100 mb-2" style="height: 140px; max-width: 48px;">
                        <div class="stat-bar-fill" style="height: 60%;" title="Pazartesi: %60"></div>
                    </div>
                    <span class="small fw-semibold text-muted-custom">Pzt</span>
                </div>

                <!-- Salı: 80% -->
                <div class="d-flex flex-column align-items-center flex-fill">
                    <span class="small fw-bold mb-2" style="color: var(--text-main); font-size: 0.75rem;">%80</span>
                    <div class="stat-bar w-100 mb-2" style="height: 140px; max-width: 48px;">
                        <div class="stat-bar-fill" style="height: 80%;" title="Salı: %80"></div>
                    </div>
                    <span class="small fw-semibold text-muted-custom">Sal</span>
                </div>

                <!-- Çarşamba: 45% -->
                <div class="d-flex flex-column align-items-center flex-fill">
                    <span class="small fw-bold mb-2" style="color: var(--text-main); font-size: 0.75rem;">%45</span>
                    <div class="stat-bar w-100 mb-2" style="height: 140px; max-width: 48px;">
                        <div class="stat-bar-fill" style="height: 45%;" title="Çarşamba: %45"></div>
                    </div>
                    <span class="small fw-semibold text-muted-custom">Çar</span>
                </div>

                <!-- Perşembe: 90% -->
                <div class="d-flex flex-column align-items-center flex-fill">
                    <span class="small fw-bold mb-2" style="color: var(--text-main); font-size: 0.75rem;">%90</span>
                    <div class="stat-bar w-100 mb-2" style="height: 140px; max-width: 48px;">
                        <div class="stat-bar-fill" style="height: 90%;" title="Perşembe: %90"></div>
                    </div>
                    <span class="small fw-semibold text-muted-custom">Per</span>
                </div>

                <!-- Cuma: 70% -->
                <div class="d-flex flex-column align-items-center flex-fill">
                    <span class="small fw-bold mb-2" style="color: var(--text-main); font-size: 0.75rem;">%70</span>
                    <div class="stat-bar w-100 mb-2" style="height: 140px; max-width: 48px;">
                        <div class="stat-bar-fill" style="height: 70%;" title="Cuma: %70"></div>
                    </div>
                    <span class="small fw-semibold text-muted-custom">Cum</span>
                </div>

                <!-- Cumartesi: 30% -->
                <div class="d-flex flex-column align-items-center flex-fill">
                    <span class="small fw-bold mb-2" style="color: var(--text-main); font-size: 0.75rem;">%30</span>
                    <div class="stat-bar w-100 mb-2" style="height: 140px; max-width: 48px;">
                        <div class="stat-bar-fill" style="height: 30%;" title="Cumartesi: %30"></div>
                    </div>
                    <span class="small fw-semibold text-muted-custom">Cte</span>
                </div>

                <!-- Pazar: 50% -->
                <div class="d-flex flex-column align-items-center flex-fill">
                    <span class="small fw-bold mb-2" style="color: var(--text-main); font-size: 0.75rem;">%50</span>
                    <div class="stat-bar w-100 mb-2" style="height: 140px; max-width: 48px;">
                        <div class="stat-bar-fill" style="height: 50%;" title="Pazar: %50"></div>
                    </div>
                    <span class="small fw-semibold text-muted-custom">Paz</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Rozetler Section (Hidden by default) -->
    <div id="rozetlerSection" class="mb-5 d-none tab-content-panel">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h4 class="fw-bold mb-1" style="color: var(--text-main);">Rozetler</h4>
                <p class="text-muted-custom small mb-0">Öğrenme yolculuğunda kazandığın tüm rozetler</p>
            </div>
            <span class="badge rounded-pill px-3 py-2" style="background-color: var(--hover-bg); color: var(--primary); font-weight: 600;">
                <i class="bi bi-award me-1"></i> 6 Rozet
            </span>
        </div>

        <div class="row g-4">
            <!-- 1. Başlangıç (green, bi-award-fill, '0 ders tamamla') -->
            <div class="col-6 col-md-4 col-xl-2">
                <div class="badge-card skeleton-item h-100 shadow-sm" style="border-radius: 20px;">
                    <div class="badge-icon" style="background-color: rgba(16, 185, 129, 0.15); color: #10b981;">
                        <i class="bi bi-award-fill"></i>
                    </div>
                    <h6 class="fw-bold mb-1" style="color: var(--text-main);">Başlangıç</h6>
                    <p class="text-muted-custom small mb-0">0 ders tamamla</p>
                </div>
            </div>

            <!-- 2. Bilgi Avcısı (blue, bi-search, '5 ders tamamla') -->
            <div class="col-6 col-md-4 col-xl-2">
                <div class="badge-card skeleton-item h-100 shadow-sm" style="border-radius: 20px;">
                    <div class="badge-icon" style="background-color: rgba(59, 130, 246, 0.15); color: #3b82f6;">
                        <i class="bi bi-search"></i>
                    </div>
                    <h6 class="fw-bold mb-1" style="color: var(--text-main);">Bilgi Avcısı</h6>
                    <p class="text-muted-custom small mb-0">5 ders tamamla</p>
                </div>
            </div>

            <!-- 3. Sınav Ustası (purple, bi-trophy-fill, '5 sınav tamamla') -->
            <div class="col-6 col-md-4 col-xl-2">
                <div class="badge-card skeleton-item h-100 shadow-sm" style="border-radius: 20px;">
                    <div class="badge-icon" style="background-color: rgba(139, 92, 246, 0.15); color: #8b5cf6;">
                        <i class="bi bi-trophy-fill"></i>
                    </div>
                    <h6 class="fw-bold mb-1" style="color: var(--text-main);">@* Model.QuizBadgeTitle *@Sınav Ustası</h6>
                    <p class="text-muted-custom small mb-0">@* Model.QuizBadgeDescription *@5 sınav tamamla</p>
                </div>
            </div>

            <!-- 4. Disiplinli (yellow, bi-calendar-check-fill, '7 gün giriş yap') -->
            <div class="col-6 col-md-4 col-xl-2">
                <div class="badge-card skeleton-item h-100 shadow-sm" style="border-radius: 20px;">
                    <div class="badge-icon" style="background-color: rgba(245, 158, 11, 0.15); color: #f59e0b;">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                    <h6 class="fw-bold mb-1" style="color: var(--text-main);">Disiplinli</h6>
                    <p class="text-muted-custom small mb-0">7 gün giriş yap</p>
                </div>
            </div>

            <!-- 5. Hızlı Öğrenen (red, bi-lightning-fill, '100 başarı puanı') -->
            <div class="col-6 col-md-4 col-xl-2">
                <div class="badge-card skeleton-item h-100 shadow-sm" style="border-radius: 20px;">
                    <div class="badge-icon" style="background-color: rgba(239, 68, 68, 0.15); color: #ef4444;">
                        <i class="bi bi-lightning-fill"></i>
                    </div>
                    <h6 class="fw-bold mb-1" style="color: var(--text-main);">Hızlı Öğrenen</h6>
                    <p class="text-muted-custom small mb-0">100 başarı puanı</p>
                </div>
            </div>

            <!-- 6. Uzman (cyan, bi-mortarboard-fill, 'Tüm dersleri tamamla') -->
            <div class="col-6 col-md-4 col-xl-2">
                <div class="badge-card skeleton-item h-100 shadow-sm" style="border-radius: 20px;">
                    <div class="badge-icon" style="background-color: rgba(6, 182, 212, 0.15); color: #06b6d4;">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <h6 class="fw-bold mb-1" style="color: var(--text-main);">Uzman</h6>
                    <p class="text-muted-custom small mb-0">Tüm dersleri tamamla</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Başarılar Section (Hidden by default) -->
    <div id="basarilarSection" class="mb-5 d-none tab-content-panel">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h4 class="fw-bold mb-1" style="color: var(--text-main);">Başarılar</h4>
                <p class="text-muted-custom small mb-0">Platformda kazandığın kupa ve başarımlar</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-12 col-md-6">
                <div class="bento-card skeleton-item h-100 shadow-sm d-flex align-items-center gap-3" style="border-radius: 20px;">
                    <div class="badge-icon flex-shrink-0" style="background-color: rgba(245, 158, 11, 0.15); color: #f59e0b; width: 60px; height: 60px;">
                        <i class="bi bi-trophy-fill fs-3"></i>
                    </div>
                    <div class="w-100">
                        <div class="d-flex justify-content-between mb-1">
                            <h6 class="fw-bold mb-0" style="color: var(--text-main);">Yenilmez Öğrenci</h6>
                            <span class="small text-muted-custom">5/5</span>
                        </div>
                        <div class="progress" style="height: 8px; border-radius: 10px; background-color: var(--border-color);">
                            <div class="progress-bar bg-warning rounded-pill" role="progressbar" style="width: 100%;"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="bento-card skeleton-item h-100 shadow-sm d-flex align-items-center gap-3" style="border-radius: 20px;">
                    <div class="badge-icon flex-shrink-0" style="background-color: rgba(16, 185, 129, 0.15); color: #10b981; width: 60px; height: 60px;">
                        <i class="bi bi-check2-all fs-3"></i>
                    </div>
                    <div class="w-100">
                        <div class="d-flex justify-content-between mb-1">
                            <h6 class="fw-bold mb-0" style="color: var(--text-main);">Seri Katili</h6>
                            <span class="small text-muted-custom">3/7 Gün</span>
                        </div>
                        <div class="progress" style="height: 8px; border-radius: 10px; background-color: var(--border-color);">
                            <div class="progress-bar bg-success rounded-pill" role="progressbar" style="width: 42%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Make istatistikler tab have the class so we can query them all
        document.getElementById('istatistiklerTabContent').classList.add('tab-content-panel');
        
        function selectTab(tab) {
            // Remove active from all tabs
            document.querySelectorAll('.tab-custom').forEach(el => el.classList.remove('active'));
            // Hide all panels
            document.querySelectorAll('.tab-content-panel').forEach(el => el.classList.add('d-none'));
            
            // Show requested panel
            if (tab === 'stats') {
                document.getElementById('tabBtnStats').classList.add('active');
                document.getElementById('istatistiklerTabContent').classList.remove('d-none');
            } else if (tab === 'badges') {
                document.getElementById('tabBtnBadges').classList.add('active');
                document.getElementById('rozetlerSection').classList.remove('d-none');
            } else if (tab === 'achievements') {
                document.getElementById('tabBtnAchievements').classList.add('active');
                document.getElementById('basarilarSection').classList.remove('d-none');
            }
        }
    </script>
}
