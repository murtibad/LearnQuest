@{
    ViewData["Title"] = "Quiz Arena";
    Layout = "_Layout";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 100px);">
    <div class="text-center bento-card p-5 mx-3" style="max-width: 500px; background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.05);">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4" style="width: 80px; height: 80px; background: rgba(79,70,229,0.1); color: #4F46E5;">
            <i class="bi bi-controller" style="font-size: 2.5rem;"></i>
        </div>
        <h2 class="fw-bold mb-3" style="color: var(--text-main);">Quiz Arena — Çok Yakında!</h2>
        <p class="text-muted-custom mb-0">Quiz Arena şu anda geliştirme aşamasında. Çok yakında burada bilgilerini test edip harika rozetler kazanabileceksin.</p>
    </div>
</div>

