@{
    Layout = "_Layout";
    ViewData["Title"] = "İstatistikler";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1" style="color: var(--text-main);">İstatistikler</h2>
        <p class="text-muted-custom mb-0">Öğrenme sürecindeki ilerlemeni detaylı olarak takip et.</p>
    </div>

    <!-- Top Stat Cards (4 in a row) -->
    <div class="row g-4 mb-4">
        <!-- Toplam Çalışma Süresi -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 shadow-sm" style="border-radius: 20px; background-color: var(--card-bg); border: 1px solid var(--border-color); transition: all 0.3s ease;">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 60px; height: 60px; background-color: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                        <i class="bi bi-clock-fill fs-3"></i>
                    </div>
                    <div>
                        <p class="mb-0 small fw-medium text-muted-custom">Toplam Çalışma Süresi</p>
                        <h3 class="fw-bold mb-0" style="color: var(--text-main);">24 Saat</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tamamlanan Ders -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 shadow-sm" style="border-radius: 20px; background-color: var(--card-bg); border: 1px solid var(--border-color); transition: all 0.3s ease;">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 60px; height: 60px; background-color: rgba(16, 185, 129, 0.1); color: #10b981;">
                        <i class="bi bi-check-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <p class="mb-0 small fw-medium text-muted-custom">Tamamlanan Ders</p>
                        <h3 class="fw-bold mb-0" style="color: var(--text-main);">8 / 12</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ortalama Sınav Puanı -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 shadow-sm" style="border-radius: 20px; background-color: var(--card-bg); border: 1px solid var(--border-color); transition: all 0.3s ease;">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 60px; height: 60px; background-color: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                        <i class="bi bi-star-fill fs-3"></i>
                    </div>
                    <div>
                        <p class="mb-0 small fw-medium text-muted-custom">Ortalama Sınav Puanı</p>
                        <h3 class="fw-bold mb-0" style="color: var(--text-main);">78</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Kazanılan Rozet -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 shadow-sm" style="border-radius: 20px; background-color: var(--card-bg); border: 1px solid var(--border-color); transition: all 0.3s ease;">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 60px; height: 60px; background-color: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                        <i class="bi bi-award-fill fs-3"></i>
                    </div>
                    <div>
                        <p class="mb-0 small fw-medium text-muted-custom">Kazanılan Rozet</p>
                        <h3 class="fw-bold mb-0" style="color: var(--text-main);">3 / 6</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Two-column section -->
    <div class="row g-4 mb-4">
        <!-- Haftalık Aktivite (Left col-lg-7) -->
        <div class="col-lg-7">
            <div class="card h-100 shadow-sm" style="border-radius: 20px; background-color: var(--card-bg); border: 1px solid var(--border-color);">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h5 class="fw-bold mb-1" style="color: var(--text-main);">Haftalık Aktivite</h5>
                            <p class="text-muted-custom small mb-0">Haftalık çalışma sürelerinin gün bazlı dağılımı</p>
                        </div>
                        <span class="badge rounded-pill px-3 py-2" style="background-color: var(--hover-bg); color: var(--hover-text); font-weight: 600;">21 Saat</span>
                    </div>

                    <!-- CSS Bar Chart -->
                    <div class="overflow-x-auto pb-2">
                        <div style="min-width: 360px;">
                            <!-- Bars Container -->
                            <div class="d-flex justify-content-between align-items-end pt-3" style="height: 190px;">
                                <!-- Pazartesi: 3s (%60) -->
                                <div class="d-flex align-items-end justify-content-center flex-grow-1 h-100">
                                    <div style="width: 40px; height: 60%; background: linear-gradient(180deg, #6366f1 0%, #4F46E5 100%); border-radius: 8px 8px 0 0;" title="Pazartesi: 3 saat"></div>
                                </div>
                                <!-- Salı: 4s (%80) -->
                                <div class="d-flex align-items-end justify-content-center flex-grow-1 h-100">
                                    <div style="width: 40px; height: 80%; background: linear-gradient(180deg, #6366f1 0%, #4F46E5 100%); border-radius: 8px 8px 0 0;" title="Salı: 4 saat"></div>
                                </div>
                                <!-- Çarşamba: 2s (%40) -->
                                <div class="d-flex align-items-end justify-content-center flex-grow-1 h-100">
                                    <div style="width: 40px; height: 40%; background: linear-gradient(180deg, #6366f1 0%, #4F46E5 100%); border-radius: 8px 8px 0 0;" title="Çarşamba: 2 saat"></div>
                                </div>
                                <!-- Perşembe: 5s (%100) -->
                                <div class="d-flex align-items-end justify-content-center flex-grow-1 h-100">
                                    <div style="width: 40px; height: 100%; background: linear-gradient(180deg, #6366f1 0%, #4F46E5 100%); border-radius: 8px 8px 0 0;" title="Perşembe: 5 saat"></div>
                                </div>
                                <!-- Cuma: 3.5s (%70) -->
                                <div class="d-flex align-items-end justify-content-center flex-grow-1 h-100">
                                    <div style="width: 40px; height: 70%; background: linear-gradient(180deg, #6366f1 0%, #4F46E5 100%); border-radius: 8px 8px 0 0;" title="Cuma: 3.5 saat"></div>
                                </div>
                                <!-- Cumartesi: 1s (%20) -->
                                <div class="d-flex align-items-end justify-content-center flex-grow-1 h-100">
                                    <div style="width: 40px; height: 20%; background: linear-gradient(180deg, #6366f1 0%, #4F46E5 100%); border-radius: 8px 8px 0 0;" title="Cumartesi: 1 saat"></div>
                                </div>
                                <!-- Pazar: 2.5s (%50) -->
                                <div class="d-flex align-items-end justify-content-center flex-grow-1 h-100">
                                    <div style="width: 40px; height: 50%; background: linear-gradient(180deg, #6366f1 0%, #4F46E5 100%); border-radius: 8px 8px 0 0;" title="Pazar: 2.5 saat"></div>
                                </div>
                            </div>

                            <!-- Baseline Divider -->
                            <div style="border-bottom: 2px solid var(--border-color);" class="w-100 my-2"></div>

                            <!-- Labels Container (Day label and hour label below each bar) -->
                            <div class="d-flex justify-content-between">
                                <div class="text-center flex-grow-1">
                                    <span class="d-block fw-semibold small" style="color: var(--text-main);">Pzt</span>
                                    <span class="d-block text-muted-custom" style="font-size: 0.75rem;">3s</span>
                                </div>
                                <div class="text-center flex-grow-1">
                                    <span class="d-block fw-semibold small" style="color: var(--text-main);">Sal</span>
                                    <span class="d-block text-muted-custom" style="font-size: 0.75rem;">4s</span>
                                </div>
                                <div class="text-center flex-grow-1">
                                    <span class="d-block fw-semibold small" style="color: var(--text-main);">Çar</span>
                                    <span class="d-block text-muted-custom" style="font-size: 0.75rem;">2s</span>
                                </div>
                                <div class="text-center flex-grow-1">
                                    <span class="d-block fw-semibold small" style="color: var(--text-main);">Per</span>
                                    <span class="d-block text-muted-custom" style="font-size: 0.75rem;">5s</span>
                                </div>
                                <div class="text-center flex-grow-1">
                                    <span class="d-block fw-semibold small" style="color: var(--text-main);">Cum</span>
                                    <span class="d-block text-muted-custom" style="font-size: 0.75rem;">3.5s</span>
                                </div>
                                <div class="text-center flex-grow-1">
                                    <span class="d-block fw-semibold small" style="color: var(--text-main);">Cte</span>
                                    <span class="d-block text-muted-custom" style="font-size: 0.75rem;">1s</span>
                                </div>
                                <div class="text-center flex-grow-1">
                                    <span class="d-block fw-semibold small" style="color: var(--text-main);">Paz</span>
                                    <span class="d-block text-muted-custom" style="font-size: 0.75rem;">2.5s</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ders İlerlemesi (Right col-lg-5) -->
        <div class="col-lg-5">
            <div class="card h-100 shadow-sm" style="border-radius: 20px; background-color: var(--card-bg); border: 1px solid var(--border-color);">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h5 class="fw-bold mb-1" style="color: var(--text-main);">Ders İlerlemesi</h5>
                                <p class="text-muted-custom small mb-0">Kayıtlı olunan derslerdeki genel durum</p>
                            </div>
                        </div>

                        <div class="d-flex flex-column gap-4">
                            <!-- C# Temelleri: 80% (blue) -->
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-code-slash" style="color: #3b82f6;"></i>
                                        <span class="fw-semibold" style="color: var(--text-main);">C# Temelleri</span>
                                    </div>
                                    <span class="fw-bold small" style="color: #3b82f6;">%80</span>
                                </div>
                                <div class="progress" style="height: 8px; border-radius: 10px; background-color: var(--border-color);">
                                    <div class="progress-bar rounded-pill" role="progressbar" style="width: 80%; background-color: #3b82f6;" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>

                            <!-- SQL Veritabanı: 70% (green) -->
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-database" style="color: #10b981;"></i>
                                        <span class="fw-semibold" style="color: var(--text-main);">SQL Veritabanı</span>
                                    </div>
                                    <span class="fw-bold small" style="color: #10b981;">%70</span>
                                </div>
                                <div class="progress" style="height: 8px; border-radius: 10px; background-color: var(--border-color);">
                                    <div class="progress-bar rounded-pill" role="progressbar" style="width: 70%; background-color: #10b981;" aria-valuenow="70" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>

                            <!-- ASP.NET MVC: 45% (purple) -->
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-braces-asterisk" style="color: #8b5cf6;"></i>
                                        <span class="fw-semibold" style="color: var(--text-main);">ASP.NET MVC</span>
                                    </div>
                                    <span class="fw-bold small" style="color: #8b5cf6;">%45</span>
                                </div>
                                <div class="progress" style="height: 8px; border-radius: 10px; background-color: var(--border-color);">
                                    <div class="progress-bar rounded-pill" role="progressbar" style="width: 45%; background-color: #8b5cf6;" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>

                            <!-- JavaScript: 30% (yellow) -->
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-filetype-js" style="color: #f59e0b;"></i>
                                        <span class="fw-semibold" style="color: var(--text-main);">JavaScript</span>
                                    </div>
                                    <span class="fw-bold small" style="color: #f59e0b;">%30</span>
                                </div>
                                <div class="progress" style="height: 8px; border-radius: 10px; background-color: var(--border-color);">
                                    <div class="progress-bar rounded-pill" role="progressbar" style="width: 30%; background-color: #f59e0b;" aria-valuenow="30" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom section: Son Başarılar card -->
    <div class="card shadow-sm" style="border-radius: 20px; background-color: var(--card-bg); border: 1px solid var(--border-color);">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-1" style="color: var(--text-main);">Son Başarılar</h5>
                    <p class="text-muted-custom small mb-0">Öğrenim sürecinde kazandığın en son başarılar ve rozetler</p>
                </div>
            </div>

            <div class="row g-4">
                <!-- İlk Ders -->
                <div class="col-12 col-md-4">
                    <div class="p-3 d-flex align-items-center gap-3 rounded-4 h-100" style="background-color: var(--bg-main); border: 1px solid var(--border-color);">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 shadow-sm" style="width: 52px; height: 52px; background-color: #10b981; color: #ffffff;">
                            <i class="bi bi-check-circle-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: var(--text-main);">İlk Ders</h6>
                            <p class="text-muted-custom small mb-0">İlk dersini tamamladın!</p>
                        </div>
                    </div>
                </div>

                <!-- Hızlı Öğrenci -->
                <div class="col-12 col-md-4">
                    <div class="p-3 d-flex align-items-center gap-3 rounded-4 h-100" style="background-color: var(--bg-main); border: 1px solid var(--border-color);">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 shadow-sm" style="width: 52px; height: 52px; background-color: #3b82f6; color: #ffffff;">
                            <i class="bi bi-lightning-charge-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: var(--text-main);">Hızlı Öğrenci</h6>
                            <p class="text-muted-custom small mb-0">3 dersi bir günde tamamladın!</p>
                        </div>
                    </div>
                </div>

                <!-- Quiz Master -->
                <div class="col-12 col-md-4">
                    <div class="p-3 d-flex align-items-center gap-3 rounded-4 h-100" style="background-color: var(--bg-main); border: 1px solid var(--border-color);">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 shadow-sm" style="width: 52px; height: 52px; background-color: #8b5cf6; color: #ffffff;">
                            <i class="bi bi-trophy-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: var(--text-main);">Quiz Master</h6>
                            <p class="text-muted-custom small mb-0">5 sınavda tam puan aldın!</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
