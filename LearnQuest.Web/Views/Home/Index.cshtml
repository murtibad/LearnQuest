@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <script src="~/js/site.js"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LearnQuest — Öğren, Seviyeni Yükselt!</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%234F46E5'><path d='M8 2.223 1 5.373v.13l7 3.15 7-3.15v-.13L8 2.223zm0 6.5-6-2.7v5.47c0 1.25.968 2.378 2.802 2.92C6.183 14.836 7.151 15 8 15c.849 0 1.817-.164 3.198-.587 1.834-.542 2.802-1.67 2.802-2.92V6.023l-6 2.7z'/></svg>">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" />
    
    <style>
        html { scroll-behavior: smooth; }
        body { overflow-x: hidden; }
        
        /* ===== NAVBAR ===== */
        .navbar {
            padding: 1rem 5%;
            background-color: transparent;
            transition: all 0.4s ease;
            z-index: 1000;
        }
        .navbar.scrolled {
            background-color: var(--sidebar-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 4px 30px rgba(0,0,0,0.08);
            border-bottom: 1px solid var(--border-color);
        }
        .navbar-brand { font-weight: 800; font-size: 1.5rem; color: var(--text-main) !important; display: flex; align-items: center; gap: 10px; }
        .logo-icon {
            width: 42px; height: 42px; border-radius: 12px;
            background: linear-gradient(135deg, #4F46E5, #06b6d4);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.3rem; color: white;
        }
        .nav-link-custom { color: var(--text-muted) !important; font-weight: 500; transition: color 0.3s; padding: 8px 16px !important; border-radius: 8px; }
        .nav-link-custom:hover { color: var(--text-main) !important; background-color: var(--hover-bg); }
        
        .theme-toggle-btn {
            border-radius: 12px; width: 44px; height: 44px;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.3s ease; border: 1px solid var(--border-color);
            background: var(--card-bg); color: var(--text-main); cursor: pointer;
        }
        .theme-toggle-btn:hover { background: var(--hover-bg); }
        
        /* ===== HERO SECTION ===== */
        .hero-section {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 120px 5% 80px;
            position: relative;
            overflow: hidden;
        }
        
        /* Ambient background blobs */
        .hero-blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.15;
            z-index: 0;
        }
        .hero-blob-1 { width: 600px; height: 600px; background: #4F46E5; top: -200px; right: -100px; }
        .hero-blob-2 { width: 400px; height: 400px; background: #06b6d4; bottom: -100px; left: -100px; }
        .hero-blob-3 { width: 300px; height: 300px; background: #8b5cf6; top: 50%; left: 40%; }
        
        .hero-title {
            font-size: clamp(2.5rem, 6vw, 4.5rem);
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 1.5rem;
        }
        .hero-title .gradient-text {
            background: linear-gradient(135deg, #4F46E5, #06b6d4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero-subtitle { font-size: 1.2rem; margin-bottom: 2.5rem; max-width: 480px; line-height: 1.7; }
        
        .btn-primary-custom {
            background: linear-gradient(135deg, #4F46E5, #6366f1);
            color: white; border-radius: 14px; padding: 14px 36px;
            font-weight: 700; border: none; font-size: 1rem;
            transition: all 0.3s ease; display: inline-flex; align-items: center; gap: 8px;
            box-shadow: 0 4px 20px rgba(79, 70, 229, 0.3);
        }
        .btn-primary-custom:hover { transform: translateY(-3px); box-shadow: 0 8px 30px rgba(79, 70, 229, 0.4); color: white; }
        .btn-outline-custom {
            background: transparent; color: var(--text-main);
            border: 2px solid var(--border-color); border-radius: 14px;
            padding: 12px 36px; font-weight: 700; font-size: 1rem;
            transition: all 0.3s ease; display: inline-flex; align-items: center; gap: 8px;
        }
        .btn-outline-custom:hover { border-color: #4F46E5; color: #4F46E5; transform: translateY(-3px); }
        
        /* ===== FLOATING CARDS (Hero Right Side) ===== */
        .floating-cards {
            position: relative;
            width: 100%;
            height: 500px;
        }
        .float-card {
            position: absolute;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
            z-index: 1;
        }
        .float-card:hover { transform: translateY(-5px) !important; }
        
        /* Card positions */
        .float-card-1 { top: 0; left: 10%; width: 260px; animation: floatUp 6s ease-in-out infinite; }
        .float-card-2 { top: 60px; right: 5%; width: 220px; animation: floatUp 7s ease-in-out infinite 1s; }
        .float-card-3 { bottom: 80px; left: 5%; width: 240px; animation: floatUp 5s ease-in-out infinite 0.5s; }
        .float-card-4 { bottom: 20px; right: 10%; width: 200px; animation: floatUp 8s ease-in-out infinite 2s; }
        
        @@keyframes floatUp {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }
        
        /* ===== SECTIONS ===== */
        .section-padding { padding: 100px 5%; }
        .section-title { font-size: 2.5rem; font-weight: 800; margin-bottom: 1rem; text-align: center; }
        .section-subtitle { text-align: center; max-width: 600px; margin: 0 auto 4rem auto; font-size: 1.1rem; line-height: 1.7; }
        
        .bento-card-home {
            background-color: var(--card-bg);
            border-radius: 24px;
            padding: 2rem;
            height: 100%;
            border: 1px solid var(--border-color);
            transition: all 0.4s ease;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        }
        .bento-card-home:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
        .icon-box {
            width: 64px; height: 64px; border-radius: 18px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem; margin-bottom: 1.5rem;
        }
        
        /* Contact form */
        .form-control-home {
            background-color: var(--bg-main); border: 1px solid var(--border-color);
            color: var(--text-main); border-radius: 14px; padding: 14px 20px;
            transition: all 0.3s ease; width: 100%;
        }
        .form-control-home:focus { background-color: var(--bg-main); border-color: #4F46E5; color: var(--text-main); box-shadow: 0 0 0 3px rgba(79,70,229,0.15); outline: none; }
        .form-control-home::placeholder { color: var(--text-muted); }
        
        /* ===== SCROLL ANIMATIONS ===== */
        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
        .reveal-delay-1 { transition-delay: 0.1s; }
        .reveal-delay-2 { transition-delay: 0.2s; }
        .reveal-delay-3 { transition-delay: 0.3s; }
        
        /* ===== STATS BAR ===== */
        .stats-section {
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
            padding: 40px 5%;
        }
        
        /* ===== FOOTER ===== */
        footer a { color: var(--text-muted); text-decoration: none; transition: color 0.3s; }
        footer a:hover { color: var(--text-main); }
        
        /* ===== RESPONSIVE ===== */
        @@media (max-width: 768px) {
            .floating-cards { display: none; }
            .hero-section { text-align: center; }
            .hero-subtitle { margin-left: auto; margin-right: auto; }
            .hero-buttons { justify-content: center !important; }
        }
    </style>
</head>
<body>

    <!-- Navbar (glass effect on scroll) -->
    <nav class="navbar navbar-expand-lg fixed-top" id="mainNav">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <div class="logo-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                LearnQuest
            </a>
            <div class="d-flex align-items-center gap-2">
                <a href="#home" class="nav-link-custom d-none d-lg-block">Ana Sayfa</a>
                <a href="#about" class="nav-link-custom d-none d-lg-block">Hakkımızda</a>
                <a href="#contact" class="nav-link-custom d-none d-lg-block">İletişim</a>
                <button id="themeToggle" class="theme-toggle-btn ms-2">
                    <i id="themeIcon" class="bi bi-moon-stars-fill fs-5"></i>
                </button>
            </div>
        </div>
    </nav>

    <!-- ===== HERO ===== -->
    <section id="home" class="hero-section">
        <!-- Ambient blobs -->
        <div class="hero-blob hero-blob-1"></div>
        <div class="hero-blob hero-blob-2"></div>
        <div class="hero-blob hero-blob-3"></div>
        
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-lg-6 z-1 pe-lg-5">
                    <div class="d-inline-flex align-items-center gap-2 rounded-pill px-3 py-2 mb-4" style="background-color: var(--hover-bg); color: var(--hover-text); font-weight: 600; font-size: 0.85rem;">
                        <i class="bi bi-stars"></i>
                        Yeni nesil öğrenme platformu
                    </div>
                    <h1 class="hero-title">
                        Öğren,<br/>
                        <span class="gradient-text">Seviyeni Yükselt!</span>
                    </h1>
                    <p class="hero-subtitle text-muted-custom">
                        Eğlenerek öğren, başarıya ulaş. Oyunlaştırılmış dersler, interaktif sınavlar ve epik rozetlerle kendin için en iyi versiyonunu oluştur!
                    </p>
                    <div class="d-flex gap-3 flex-wrap hero-buttons">
                        <a href="/Auth/Login" class="btn btn-primary-custom text-decoration-none">
                            <i class="bi bi-box-arrow-in-right"></i> Giriş Yap
                        </a>
                        <a href="/Auth/Register" class="btn btn-outline-custom text-decoration-none">
                            <i class="bi bi-person-plus"></i> Kayıt Ol
                        </a>
                    </div>
                </div>
                
                <!-- Floating Preview Cards -->
                <div class="col-lg-6 d-none d-lg-block">
                    <div class="floating-cards">
                        <!-- XP Card -->
                        <div class="float-card float-card-1">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(79,70,229,0.1); color: #4F46E5;">
                                    <i class="bi bi-shield-fill fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-bold small" style="color: var(--text-main);">Seviye 5</div>
                                    <div class="small text-muted-custom">320 / 600 XP</div>
                                </div>
                            </div>
                            <div class="progress" style="height: 8px; border-radius: 8px;">
                                <div class="progress-bar rounded-pill" style="width: 53%; background: linear-gradient(90deg, #4F46E5, #06b6d4);"></div>
                            </div>
                        </div>
                        
                        <!-- Quiz Score Card -->
                        <div class="float-card float-card-2">
                            <div class="text-center">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2" style="width: 50px; height: 50px; background: rgba(16,185,129,0.1); color: #10b981;">
                                    <i class="bi bi-check-circle-fill fs-4"></i>
                                </div>
                                <div class="fw-bold" style="color: var(--text-main);">Doğru!</div>
                                <div class="fw-bold" style="color: #10b981; font-size: 1.2rem;">+50 XP</div>
                            </div>
                        </div>
                        
                        <!-- Stats Card -->
                        <div class="float-card float-card-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(245,158,11,0.1); color: #f59e0b;">
                                    <i class="bi bi-trophy-fill fs-5"></i>
                                </div>
                                <div>
                                    <div class="small text-muted-custom">Toplam Puan</div>
                                    <div class="fw-bold fs-4" style="color: var(--text-main);">4.320</div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Badge Card -->
                        <div class="float-card float-card-4">
                            <div class="text-center">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2" style="width: 50px; height: 50px; background: rgba(139,92,246,0.1); color: #8b5cf6;">
                                    <i class="bi bi-award-fill fs-4"></i>
                                </div>
                                <div class="fw-bold small" style="color: var(--text-main);">Bilgi Avcısı</div>
                                <div class="small text-muted-custom">Rozet kazanıldı!</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== STATS BAR ===== -->
    <div class="stats-section" style="background-color: var(--sidebar-bg);">
        <div class="container">
            <div class="row text-center g-4 reveal">
                <div class="col-6 col-md-3">
                    <h3 class="fw-bold mb-1" style="color: var(--text-main);">500+</h3>
                    <p class="text-muted-custom small mb-0">Aktif Öğrenci</p>
                </div>
                <div class="col-6 col-md-3">
                    <h3 class="fw-bold mb-1" style="color: var(--text-main);">12</h3>
                    <p class="text-muted-custom small mb-0">İnteraktif Ders</p>
                </div>
                <div class="col-6 col-md-3">
                    <h3 class="fw-bold mb-1" style="color: var(--text-main);">50+</h3>
                    <p class="text-muted-custom small mb-0">Quiz Sorusu</p>
                </div>
                <div class="col-6 col-md-3">
                    <h3 class="fw-bold mb-1" style="color: var(--text-main);">%95</h3>
                    <p class="text-muted-custom small mb-0">Memnuniyet</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== ABOUT ===== -->
    <section id="about" class="section-padding">
        <div class="container">
            <div class="reveal">
                <div class="d-inline-flex align-items-center gap-2 rounded-pill px-3 py-2 mb-3 mx-auto d-block" style="background-color: var(--hover-bg); color: var(--hover-text); font-weight: 600; font-size: 0.85rem; width: fit-content;">
                    <i class="bi bi-lightning-charge-fill"></i>
                    Neden LearnQuest?
                </div>
                <h2 class="section-title">Öğrenme Serüvenine Katıl</h2>
                <p class="section-subtitle text-muted-custom">LearnQuest, sıradan eğitimi destansı bir maceraya dönüştüren yeni nesil bir öğrenme platformudur.</p>
            </div>

            <div class="row g-4">
                <div class="col-md-4 reveal reveal-delay-1">
                    <div class="bento-card-home text-center">
                        <div class="icon-box mx-auto" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;"><i class="bi bi-star-fill"></i></div>
                        <h4 class="fw-bold mb-3" style="color: var(--text-main);">XP ve Seviyeler</h4>
                        <p class="text-muted-custom mb-0">Her ders sana deneyim puanı kazandırır. XP topladıkça seviye atlar, platformdaki prestijini artırırsın.</p>
                    </div>
                </div>
                <div class="col-md-4 reveal reveal-delay-2">
                    <div class="bento-card-home text-center">
                        <div class="icon-box mx-auto" style="background: rgba(16, 185, 129, 0.1); color: #10b981;"><i class="bi bi-shield-check"></i></div>
                        <h4 class="fw-bold mb-3" style="color: var(--text-main);">Epik Rozetler</h4>
                        <p class="text-muted-custom mb-0">Zorlu görevleri tamamla, başarılarının kilidini aç ve profilinde sergileyebileceğin benzersiz rozetler kazan.</p>
                    </div>
                </div>
                <div class="col-md-4 reveal reveal-delay-3">
                    <div class="bento-card-home text-center">
                        <div class="icon-box mx-auto" style="background: rgba(168, 85, 247, 0.1); color: #a855f7;"><i class="bi bi-controller"></i></div>
                        <h4 class="fw-bold mb-3" style="color: var(--text-main);">Oyunlaştırılmış Testler</h4>
                        <p class="text-muted-custom mb-0">Sıkıcı sınavlar yerine, zamanla yarıştığın interaktif soru arenalarında kendini test et.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== CONTACT ===== -->
    <section id="contact" class="section-padding" style="background-color: var(--sidebar-bg); transition: background-color 0.3s;">
        <div class="container">
            <div class="reveal">
                <div class="bento-card-home mx-auto" style="max-width: 700px; padding: 3rem; box-shadow: 0 20px 50px rgba(0,0,0,0.06);">
                    <div class="text-center mb-5">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 64px; height: 64px; background: rgba(79,70,229,0.1); color: #4F46E5;">
                            <i class="bi bi-envelope-paper-fill fs-3"></i>
                        </div>
                        <h2 class="fw-bold mb-2" style="color: var(--text-main);">Bize Ulaşın</h2>
                        <p class="text-muted-custom">Maceranda bir sorunla mı karşılaştın? Bize hemen mesaj gönder.</p>
                    </div>
                    <form action="#" method="post">
                        <div class="mb-4">
                            <label class="form-label text-muted-custom small fw-medium">Adın Soyadın</label>
                            <input type="text" class="form-control-home" placeholder="Kahramanın Adı..." required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-muted-custom small fw-medium">E-posta Adresin</label>
                            <input type="email" class="form-control-home" placeholder="ornek@subu.edu.tr" required>
                        </div>
                        <div class="mb-5">
                            <label class="form-label text-muted-custom small fw-medium">Mesajın</label>
                            <textarea class="form-control-home" rows="4" placeholder="Nasıl yardımcı olabiliriz?" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary-custom w-100 justify-content-center">
                            Mesajı Gönder <i class="bi bi-send-fill"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== FOOTER ===== -->
    <footer class="py-5 border-top" style="border-color: var(--border-color) !important; background-color: var(--bg-main);">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="logo-icon" style="width: 32px; height: 32px; font-size: 0.9rem; border-radius: 8px;">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        <span class="fw-bold" style="color: var(--text-main);">LearnQuest</span>
                    </div>
                    <p class="text-muted-custom small mb-0">Eğlenerek öğren, başarıya ulaş.</p>
                </div>
                <div class="col-md-4 text-center">
                    <div class="d-flex gap-3 justify-content-center">
                        <a href="#home">Ana Sayfa</a>
                        <a href="#about">Hakkımızda</a>
                        <a href="#contact">İletişim</a>
                    </div>
                </div>
                <div class="col-md-4 text-md-end">
                    <p class="text-muted-custom small mb-0">&copy; 2026 LearnQuest. Tüm hakları saklıdır.</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- ===== SCRIPTS ===== -->
    <script>
        // Navbar scroll effect
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('mainNav');
            if (window.scrollY > 50) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });

        // Scroll reveal animations (IntersectionObserver)
        const revealElements = document.querySelectorAll('.reveal');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, { threshold: 0.15 });

        revealElements.forEach(el => observer.observe(el));
    </script>
</body>
</html>
</html>