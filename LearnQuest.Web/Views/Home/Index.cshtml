@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <script src="~/js/site.js"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LearnQuest - Level Up Your Skills</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><text y=%2214%22 font-size=%2214%22>🎮</text></svg>">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" />
    
    <style>
        html { scroll-behavior: smooth; }
        
        .navbar { padding: 1.5rem 5%; background-color: var(--sidebar-bg); backdrop-filter: blur(10px); transition: background-color 0.3s ease; }
        .navbar-brand { font-weight: 700; font-size: 1.5rem; color: var(--text-main) !important; }
        .nav-link { color: var(--text-muted) !important; font-weight: 500; transition: color 0.3s; }
        .nav-link:hover { color: var(--text-main) !important; }
        
        .hero-section { min-height: 85vh; display: flex; align-items: center; padding: 4rem 5%; position: relative; }
        .hero-title { font-size: 4rem; font-weight: 700; margin-bottom: 1.5rem; line-height: 1.2; }
        .hero-subtitle { font-size: 1.25rem; margin-bottom: 2.5rem; }
        
        .btn-primary-custom { background-color: #4F46E5; color: white; border-radius: 50px; padding: 12px 32px; font-weight: 600; border: none; width: 200px; transition: all 0.3s ease; display: inline-block; }
        .btn-primary-custom:hover { background-color: #4338ca; color: white; transform: translateY(-2px); }
        .btn-outline-custom { background-color: transparent; color: var(--text-main); border: 2px solid var(--text-main); border-radius: 50px; padding: 10px 32px; font-weight: 600; width: 200px; transition: all 0.3s ease; display: inline-block; }
        .btn-outline-custom:hover { background-color: var(--text-main); color: var(--bg-main); transform: translateY(-2px); }

        .hero-image-container { position: relative; width: 100%; height: 600px; display: flex; justify-content: center; align-items: center; }
        .hero-image-container img { width: 100%; height: 100%; object-fit: cover; z-index: 1; border-radius: 24px; }
        .ambient-glow { position: absolute; width: 100%; height: 100%; background: #4F46E5; filter: blur(100px); opacity: 0.2; z-index: 0; }

        .section-padding { padding: 6rem 5%; }
        .section-title { font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; text-align: center; }
        .section-subtitle { text-align: center; max-width: 600px; margin: 0 auto 4rem auto; font-size: 1.1rem; }
        
        .bento-card-dynamic { background-color: var(--card-bg); border-radius: 24px; padding: 2rem; height: 100%; border: 1px solid var(--border-color); transition: all 0.3s ease; box-shadow: 0 4px 20px rgba(0,0,0,0.03); }
        .bento-card-dynamic:hover { transform: translateY(-5px); }
        .icon-box { width: 60px; height: 60px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 1.5rem; margin-left: auto; margin-right: auto;}
        
        .form-control-dynamic { background-color: var(--bg-main); border: 1px solid var(--border-color); color: var(--text-main); border-radius: 12px; padding: 14px 20px; transition: all 0.3s ease; }
        .form-control-dynamic:focus { background-color: var(--bg-main); border-color: #4F46E5; color: var(--text-main); box-shadow: none; }
        .form-control-dynamic::placeholder { color: var(--text-muted); }
        
        .theme-toggle-btn { border-radius: 50%; width: 45px; height: 45px; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease; border: 1px solid var(--border-color); background: var(--card-bg); color: var(--text-main); }
        .theme-toggle-btn:hover { background: var(--border-color); }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg fixed-top border-bottom border-secondary border-opacity-10">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <img src="~/images/logo.jpg" alt="Logo" style="height: 40px; width: 40px; border-radius: 50%;">
                LearnQuest
            </a>
            <div class="d-flex align-items-center gap-4">
                <a href="#home" class="nav-link d-none d-lg-block">Ana Sayfa</a>
                <a href="#about" class="nav-link d-none d-lg-block">Hakkımızda</a>
                <a href="#contact" class="nav-link d-none d-lg-block">İletişim</a>
                <button id="themeToggle" class="theme-toggle-btn ms-3">
                    <i id="themeIcon" class="bi bi-moon-stars-fill fs-5"></i>
                </button>
            </div>
        </div>
    </nav>

    <section id="home" class="hero-section mt-5">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-md-5 z-1 pe-lg-5">
                    <h1 class="hero-title">Öğren,<br />Seviyeni Yükselt!</h1>
                    <p class="hero-subtitle text-muted-custom">Eğlenerek öğren, başarıya ulaş.<br />Kendin için en iyi versiyonunu oluştur!</p>
                    <div class="d-flex flex-column gap-3 align-items-start">
                        <a href="/Auth/Login" class="btn btn-primary-custom text-center text-decoration-none">Giriş Yap</a>
                        <a href="/Auth/Register" class="btn btn-outline-custom text-center text-decoration-none">Kayıt Ol</a>
                    </div>
                </div>
                <div class="col-md-7 d-none d-md-block">
                    <div class="hero-image-container">
                        <div class="ambient-glow"></div>
                        <img src="~/images/hero-adventure.jpg" alt="Adventure" class="shadow-lg border border-secondary border-opacity-25" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="about" class="section-padding" style="background-color: var(--sidebar-bg); transition: background-color 0.3s ease;">
        <div class="container">
            <h6 class="text-primary text-center fw-bold text-uppercase tracking-wider mb-2">HAKKIMIZDA</h6>
            <h2 class="section-title">Öğrenme Serüvenine Katıl</h2>
            <p class="section-subtitle text-muted-custom">LearnQuest, sıradan eğitimi destansı bir maceraya dönüştüren yeni nesil bir platformdur.</p>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="bento-card-dynamic text-center">
                        <div class="icon-box" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;"><i class="bi bi-star-fill"></i></div>
                        <h4 class="fw-bold mb-3">XP ve Seviyeler</h4>
                        <p class="text-muted-custom mb-0">Her ders sana deneyim puanı kazandırır. XP topladıkça seviye atlar, platformdaki prestijini artırırsın.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="bento-card-dynamic text-center">
                        <div class="icon-box" style="background: rgba(16, 185, 129, 0.1); color: #10b981;"><i class="bi bi-shield-check"></i></div>
                        <h4 class="fw-bold mb-3">Epik Rozetler</h4>
                        <p class="text-muted-custom mb-0">Zorlu görevleri tamamla, başarılarının kilidini aç ve profilinde sergileyebileceğin benzersiz rozetler kazan.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="bento-card-dynamic text-center">
                        <div class="icon-box" style="background: rgba(168, 85, 247, 0.1); color: #a855f7;"><i class="bi bi-controller"></i></div>
                        <h4 class="fw-bold mb-3">Oyunlaştırılmış Testler</h4>
                        <p class="text-muted-custom mb-0">Sıkıcı sınavlar yerine, zamanla yarıştığın interaktif soru arenalarında kendini test et.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="contact" class="section-padding">
        <div class="container">
            <div class="bento-card-dynamic shadow-lg mx-auto" style="max-width: 700px; padding: 3rem;">
                <div class="text-center mb-5">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-envelope-paper-fill fs-3"></i>
                    </div>
                    <h2 class="fw-bold mb-2">Bize Ulaşın</h2>
                    <p class="text-muted-custom">Maceranda bir sorunla mı karşılaştın? Bize hemen mesaj gönder.</p>
                </div>
                <form action="#" method="post">
                    <div class="mb-4">
                        <label class="form-label text-muted-custom small fw-medium">Adın Soyadın</label>
                        <input type="text" class="form-control-dynamic w-100" placeholder="Kahramanın Adı..." required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-muted-custom small fw-medium">E-posta Adresin</label>
                        <input type="email" class="form-control-dynamic w-100" placeholder="ornek@subu.edu.tr" required>
                    </div>
                    <div class="mb-5">
                        <label class="form-label text-muted-custom small fw-medium">Mesajın</label>
                        <textarea class="form-control-dynamic w-100" rows="4" placeholder="Nasıl yardımcı olabiliriz?" required></textarea>
                    </div>
                    <button type="submit" class="btn-primary-custom w-100 d-flex justify-content-center align-items-center gap-2">
                        Mesajı Gönder <i class="bi bi-send-fill"></i>
                    </button>
                </form>
            </div>
        </div>
    </section>

    <footer class="py-4 text-center border-top border-secondary border-opacity-10" style="background-color: var(--sidebar-bg); transition: background-color 0.3s ease;">
        <p class="text-muted-custom small mb-0">&copy; 2026 LearnQuest. All Rights Reserved.</p>
    </footer>
</body>
</html>