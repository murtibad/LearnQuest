@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LearnQuest</title>
    
    <!-- Favicon Configuration -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><text y=%2214%22 font-size=%2214%22>🎮</text></svg>">
    
    <!-- External Dependencies & Fonts -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        html { scroll-behavior: smooth; }
        body {
            background-color: #0b1120;
            color: white;
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }
        
        /* Navbar Styles */
        .navbar-brand { font-weight: 700; font-size: 1.5rem; color: white !important; }
        
        /* Hero Section Layout */
        .hero-section { flex-grow: 1; display: flex; align-items: center; padding: 4rem 5%; }
        .hero-title { font-size: 4rem; font-weight: 700; margin-bottom: 1.5rem; line-height: 1.2; }
        .hero-subtitle { font-size: 1.25rem; color: #A3AED0; margin-bottom: 2.5rem; }
        
        /* Primary Button (Login) */
        .btn-primary-custom {
            background-color: var(--primary-blue); color: white; border-radius: 50px;
            padding: 12px 32px; font-weight: 600; border: none; width: 200px;
            transition: all 0.3s ease; display: inline-block;
        }
        .btn-primary-custom:hover {
            background-color: #4338ca; color: white; transform: translateY(-2px);
        }
        
        /* Outline Button (Register) */
        .btn-outline-custom {
            background-color: transparent; color: white; border: 2px solid white;
            border-radius: 50px; padding: 10px 32px; font-weight: 600; width: 200px;
            transition: all 0.3s ease; display: inline-block;
        }
        .btn-outline-custom:hover {
            background-color: white; color: #0b1120; border: 2px solid white; transform: translateY(-2px);
        }

        /* Ambient Glow Effect */
        .ambient-glow {
            position: absolute; width: 100%; height: 100%; background: var(--primary-blue);
            filter: blur(120px); opacity: 0.2; z-index: 0; top: 0; left: 0;
        }
        
        /* Full-Size Hero Image Wrapper */
        .hero-image-wrapper {
            position: relative;
            width: 100%;
            height: 75vh; /* Scales the image to 75% of the viewport height */
            min-height: 500px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        .hero-image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
        }
    </style>
</head>
<body>

    <!-- Top Navigation -->
    <nav class="navbar navbar-expand-lg pt-4 px-5">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <i class="bi bi-controller fs-2 text-primary"></i> LearnQuest
            </a>
            <div class="d-flex gap-4">
                <a href="/" class="text-white text-decoration-none">Ana Sayfa</a>
                <a href="#about" class="text-white text-decoration-none opacity-75 hover-opacity-100">Hakkımızda</a>
                <a href="#contact" class="text-white text-decoration-none opacity-75">İletişim</a>
            </div>
        </div>
    </nav>

    <!-- Main Hero Area -->
    <div class="hero-section">
        <div class="container-fluid">
            <div class="row align-items-center">
                
                <!-- Left Column: Typography & CTAs -->
                <div class="col-md-6 d-flex flex-column justify-content-center z-1 pe-lg-5">
                    <h1 class="hero-title">Öğren,<br />Seviyeni Yükselt!</h1>
                    <p class="hero-subtitle">Eğlenerek öğren, başarıya ulaş.<br />Kendin için en iyi versiyonunu oluştur!</p>
                    
                    <div class="d-flex flex-column gap-3 align-items-start">
                        <a href="/Auth/Login" class="btn btn-primary-custom text-center text-decoration-none">Giriş Yap</a>
                        <a href="/Auth/Register" class="btn btn-outline-custom text-center text-decoration-none">Kayıt Ol</a>
                    </div>
                </div>
                
                <!-- Right Column: Expansive Hero Image -->
                <div class="col-md-6 d-none d-md-block position-relative">
                    <div class="ambient-glow"></div>
                    <div class="hero-image-wrapper">
                        <img src="~/images/hero-adventure.jpg" 
                             alt="LearnQuest Adventure" 
                             class="rounded-4 shadow-lg border border-secondary border-opacity-25" />
                    </div>
                </div>
                
            </div>
        </div>
    </div>

</body>
</html>