@{
    ViewData["Title"] = "Ana Sayfa";
    // Bu sayfanın _Layout içindeki standart menü ve container'ı kullanmamasını istiyoruz
    Layout = null; 
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LearnQuest SUBÜ - Öğren, Seviyeni Yükselt!</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        /* Sadece bu sayfaya özel, görseldeki mavi arkaplanlı hero tasarımı */
        body {
            background-color: #0b1120; /* Koyu lacivert arkaplan */
            color: white;
            font-family: 'Inter', sans-serif;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            color: white !important;
        }
        .hero-section {
            flex-grow: 1;
            display: flex;
            align-items: center;
            padding: 0 5%;
        }
        .hero-title {
            font-size: 4rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            line-height: 1.2;
        }
        .hero-subtitle {
            font-size: 1.25rem;
            color: #A3AED0;
            margin-bottom: 2.5rem;
        }
        .btn-primary-custom {
            background-color: var(--primary-blue);
            color: white;
            border-radius: 50px;
            padding: 12px 32px;
            font-weight: 600;
            border: none;
            width: 200px;
            margin-bottom: 15px;
        }
        .btn-outline-custom {
            background-color: transparent;
            color: white;
            border: 2px solid white;
            border-radius: 50px;
            padding: 10px 32px;
            font-weight: 600;
            width: 200px;
        }
    </style>
</head>
<body>

    <!-- Üst Menü -->
    <nav class="navbar navbar-expand-lg pt-4 px-5">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center gap-2" href="#">
                <i class="bi bi-controller fs-2 text-primary"></i> LearnQuest
            </a>
            <div class="d-flex gap-4">
                <a href="#" class="text-white text-decoration-none">Ana Sayfa</a>
                <a href="#" class="text-white text-decoration-none">Hakkımızda</a>
                <a href="#" class="text-white text-decoration-none">İletişim</a>
            </div>
        </div>
    </nav>

    <!-- Ana İçerik (Hero) -->
    <div class="hero-section">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-6 d-flex flex-column justify-content-center">
                    <h1 class="hero-title">Öğren,<br />Seviyeni Yükselt!</h1>
                    <p class="hero-subtitle">Eğlenerek öğren, başarıya ulaş.<br />Kendin için en iyi versiyonunu oluştur!</p>
                    
                    <div class="d-flex flex-column align-items-start">
                        <!-- Dashboard sayfasına yönlendireceğiz -->
                        <a href="/Dashboard/Index" class="btn btn-primary-custom text-center text-decoration-none">Giriş Yap</a>
                        <a href="#" class="btn btn-outline-custom text-center text-decoration-none">Kayıt Ol</a>
                    </div>
                </div>
                <!-- Sağ tarafa görseldeki gibi bir illüstrasyon veya boşluk gelecek -->
                <div class="col-md-6">
                     <!-- İleride buraya o karakter görselini koyacağız -->
                </div>
            </div>
        </div>
    </div>

</body>
</html>