@{
    ViewData["Title"] = "Quiz";
}

<style>
    /* Quiz specific styles matching the mockup */
    .quiz-container {
        background: linear-gradient(135deg, #0b1120 0%, #1e293b 100%);
        border-radius: 24px;
        padding: 40px;
        color: white;
        position: relative;
        overflow: hidden;
    }
    .quiz-option {
        background-color: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 16px 24px;
        color: white;
        font-weight: 500;
        transition: all 0.2s ease;
        cursor: pointer;
    }
    .quiz-option:hover {
        background-color: rgba(255, 255, 255, 0.1);
        border-color: var(--primary-blue);
    }
    .quiz-option.selected {
        background-color: rgba(79, 70, 229, 0.2);
        border-color: var(--primary-blue);
    }
    .quiz-option.correct {
        background-color: rgba(16, 185, 129, 0.2);
        border-color: var(--success-green);
    }
</style>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            
            <!-- Main Quiz Card -->
            <div class="quiz-container shadow-lg">
                <!-- Header: Health and Timer -->
                <div class="d-flex justify-content-between align-items-center mb-5">
                    <div class="d-flex align-items-center gap-3">
                        <div style="background-color: rgba(99, 102, 241, 0.2);" class="p-2 rounded-3 text-white border border-secondary">
                            <span class="fw-bold">Seviye 5</span>
                            <small class="ms-2 opacity-75">320 / 600 XP</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-4">
                        <div class="text-danger fs-4">
                            <i class="bi bi-heart-fill"></i>
                            <i class="bi bi-heart-fill"></i>
                            <i class="bi bi-heart-fill"></i>
                            <i class="bi bi-heart"></i>
                        </div>
                        <div class="bg-primary bg-opacity-25 px-3 py-1 rounded-pill border border-primary fs-5 fw-bold">
                            <i class="bi bi-clock me-2"></i>00:45
                        </div>
                    </div>
                </div>

                <!-- Question Area -->
                <div class="text-center mb-5">
                    <span class="text-muted text-uppercase fw-bold letter-spacing-1">Soru 2/10</span>
                    <h3 class="mt-3 fw-bold lh-base">
                        Aşağıdakilerden hangisi .NET MVC mimarisinin ana bileşenlerinden biridir?
                    </h3>
                </div>

                <!-- Options Grid -->
                <div class="row g-4 mb-5">
                    <div class="col-md-6">
                        <div class="quiz-option correct d-flex align-items-center gap-3">
                            <span class="fs-5 fw-bold opacity-75">A)</span>
                            <span class="fs-5">Controller</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="quiz-option d-flex align-items-center gap-3">
                            <span class="fs-5 fw-bold opacity-75">B)</span>
                            <span class="fs-5">ViewModel</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="quiz-option d-flex align-items-center gap-3">
                            <span class="fs-5 fw-bold opacity-75">C)</span>
                            <span class="fs-5">Repository</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="quiz-option d-flex align-items-center gap-3">
                            <span class="fs-5 fw-bold opacity-75">D)</span>
                            <span class="fs-5">DbContext</span>
                        </div>
                    </div>
                </div>

                <!-- Success Alert (Mocking correct answer state) -->
                <div class="alert bg-success bg-opacity-10 border border-success text-white d-flex justify-content-between align-items-center mb-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-4"></i>
                        <span class="fw-bold fs-5">Doğru cevap! 🎉</span>
                    </div>
                    <span class="fw-bold fs-5 text-success">+50 XP</span>
                </div>

            </div>
        </div>
    </div>
</div>