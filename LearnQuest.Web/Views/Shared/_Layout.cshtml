<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LearnQuest</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%234F46E5'><path d='M8 2.223 1 5.373v.13l7 3.15 7-3.15v-.13L8 2.223zm0 6.5-6-2.7v5.47c0 1.25.968 2.378 2.802 2.92C6.183 14.836 7.151 15 8 15c.849 0 1.817-.164 3.198-.587 1.834-.542 2.802-1.67 2.802-2.92V6.023l-6 2.7z'/></svg>">

    @await Html.PartialAsync("_ThemeInit")
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .app-container { display: flex; min-height: 100vh; }
        .main-content { flex-grow: 1; margin-left: 260px; padding-bottom: 2rem; transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .main-content.expanded { margin-left: 88px; }
        
        .sidebar { 
            width: 260px; background-color: var(--sidebar-bg); border-right: 1px solid var(--border-color); 
            display: flex; flex-direction: column; padding: 24px; position: fixed; height: 100vh; 
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.3s ease, border-color 0.3s ease;
            z-index: 1000;
        }
        .sidebar.collapsed { width: 88px; padding: 24px 16px; }
        .sidebar.collapsed .sidebar-text { display: none !important; }
        .sidebar.collapsed .sidebar-logo { justify-content: center; margin-bottom: 2rem; }
        .sidebar.collapsed .nav-link, .sidebar.collapsed .theme-btn { justify-content: center; padding: 12px; }
        .sidebar.collapsed .nav-link i, .sidebar.collapsed .theme-btn i { margin-right: 0 !important; font-size: 1.3rem; }
        
        .sidebar-toggle-btn {
            position: absolute; right: -14px; top: 32px; width: 28px; height: 28px;
            background: var(--card-bg); border: 1px solid var(--border-color);
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            color: var(--text-muted); cursor: pointer; transition: all 0.2s ease;
            z-index: 1001; box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        .sidebar-toggle-btn:hover { color: var(--primary); border-color: var(--primary); transform: scale(1.1); }
        .sidebar.collapsed .sidebar-toggle-btn i { transform: rotate(180deg); }
        .sidebar-toggle-btn i { transition: transform 0.3s ease; font-size: 0.8rem; }
        
        .theme-btn {
            background: transparent; border: 1px solid var(--border-color);
            border-radius: 12px; padding: 10px; width: 100%; text-align: left;
            display: flex; align-items: center; justify-content: center; gap: 10px;
            color: var(--text-main); transition: all 0.3s ease; cursor: pointer;
        }
        .theme-btn:hover { background-color: var(--hover-bg); }
        
        /* Smooth page transition */
        .page-transition {
            animation: fadeInPage 0.4s ease-out forwards;
        }
        @@keyframes fadeInPage {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        @@media (prefers-reduced-motion: reduce) {
            .page-transition { animation: none; opacity: 1; transform: none; }
            .sidebar, .main-content { transition: none; }
        }
    </style>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.6/dist/sweetalert2.min.css" rel="stylesheet">
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    }
    <div class="app-container">
        <!-- Partial: _Sidebar -->
        <aside class="sidebar" id="mainSidebar">
            <button class="sidebar-toggle-btn d-none d-md-flex" id="sidebarToggle" aria-label="Toggle Sidebar">
                <i class="bi bi-chevron-left"></i>
            </button>
            <a href="/" class="sidebar-logo d-flex align-items-center gap-2 text-decoration-none mb-4">
                <div class="logo-icon logo-icon-lg flex-shrink-0"><i class="bi bi-mortarboard-fill"></i></div>
                <span class="sidebar-text fw-bold fs-5 text-main" style="color: var(--text-main);">LearnQuest</span>
            </a>
            <nav class="flex-column flex-grow-1">
                <div class="nav-item mb-2"><a href="/Dashboard" class="nav-link d-flex align-items-center gap-2 @(currentController == "Dashboard" && currentAction == "Index" ? "active" : "")"><i class="bi bi-house-door-fill"></i> <span class="sidebar-text">Ana Sayfa</span></a></div>
                <div class="nav-item mb-2"><a href="/Courses" class="nav-link d-flex align-items-center gap-2 @(currentController == "Courses" ? "active" : "")"><i class="bi bi-book-half"></i> <span class="sidebar-text">Dersler</span></a></div>
                <div class="nav-item mb-2"><a href="/Dashboard/Quiz" class="nav-link d-flex align-items-center gap-2 @(currentController == "Dashboard" && currentAction == "Quiz" ? "active" : "")"><i class="bi bi-controller"></i> <span class="sidebar-text">Quiz Arena</span></a></div>
                <div class="nav-item mb-2"><a href="/Dashboard/Statistics" class="nav-link d-flex align-items-center gap-2 @(currentAction == "Statistics" ? "active" : "")"><i class="bi bi-bar-chart-line-fill"></i> <span class="sidebar-text">İstatistikler</span></a></div>
                <div class="nav-item mb-2"><a href="/Dashboard/Profile" class="nav-link d-flex align-items-center gap-2 @(currentAction == "Profile" ? "active" : "")"><i class="bi bi-person-fill"></i> <span class="sidebar-text">Profil</span></a></div>
            </nav>
            <div class="mt-auto d-flex flex-column gap-3">
                <button id="themeToggle" class="theme-btn" type="button">
                    <i id="themeIcon" class="bi bi-moon-stars-fill fs-5"></i>
                    <span class="sidebar-text fw-medium small">Tema Değiştir</span>
                </button>
                <a href="/Auth/Login" class="nav-link mt-2 d-flex align-items-center gap-2" style="color: var(--text-muted);"><i class="bi bi-box-arrow-right"></i> <span class="sidebar-text">Çıkış Yap</span></a>
            </div>
        </aside>
        <main class="main-content page-transition" id="mainContent">
            <!-- Partial: _TopBar -->
            @RenderBody()
        </main>
        <nav class="mobile-bottom-nav">
            <a href="/Dashboard" class="nav-item"><i class="bi bi-house-door-fill"></i> Ana Sayfa</a>
            <a href="/Courses" class="nav-item"><i class="bi bi-book-half"></i> Dersler</a>
            <a href="/Dashboard/Quiz" class="nav-item"><i class="bi bi-controller"></i> Quiz</a>
            <a href="/Dashboard/Statistics" class="nav-item"><i class="bi bi-bar-chart-line-fill"></i> İstatistikler</a>
            <a href="/Dashboard/Profile" class="nav-item"><i class="bi bi-person-fill"></i> Profil</a>
        </nav>
        <button id="scrollToTop" class="scroll-to-top" aria-label="Yukarı Çık" type="button"><i class="bi bi-chevron-up"></i></button>
    </div>
    
    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.6/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>