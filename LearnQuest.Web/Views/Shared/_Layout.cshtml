<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LearnQuest</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Google Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            /* Sidebar (Sol Menü) Özelleştirmeleri */
            .sidebar {
                width: 280px;
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                background-color: #0b1120;
                color: white;
                padding: 24px;
                display: flex;
                flex-direction: column;
                z-index: 1000;
            }
            .main-content {
                margin-left: 280px; /* Sidebar'ın genişliği kadar sağa itiyoruz */
                min-height: 100vh;
                background-color: var(--bg-light);
                padding: 24px;
            }
            .nav-link-custom {
                color: #A3AED0;
                border-radius: 12px;
                padding: 12px 16px;
                margin-bottom: 8px;
                display: flex;
                align-items: center;
                gap: 12px;
                transition: all 0.3s ease;
                text-decoration: none;
                font-weight: 500;
            }
            .nav-link-custom:hover, .nav-link-custom.active {
                background-color: var(--primary-blue);
                color: white;
            }
    </style>
</head>
<body>

    <!-- Sol Menü (Sidebar) -->
    <aside class="sidebar">
        <!-- Logo Alanı -->
        <a href="/" class="d-flex align-items-center gap-2 mb-5 text-white text-decoration-none">
            <i class="bi bi-controller fs-2 text-primary"></i>
            <span class="fs-4 fw-bold">LearnQuest</span>
        </a>

        <!-- Menü Linkleri -->
        <nav class="flex-column mb-auto">
            <a href="/Dashboard" class="nav-link-custom active">
                <i class="bi bi-house-door-fill"></i> Ana Sayfa
            </a>
            <a href="#" class="nav-link-custom">
                <i class="bi bi-book"></i> Dersler
            </a>
            <a href="#" class="nav-link-custom">
                <i class="bi bi-controller"></i> Oyunlar
            </a>
            <a href="#" class="nav-link-custom">
                <i class="bi bi-card-checklist"></i> Sınavlar
            </a>
            <a href="#" class="nav-link-custom">
                <i class="bi bi-bar-chart-fill"></i> İstatistikler
            </a>
        </nav>

        <!-- Çıkış Yap Butonu -->
        <a href="#" class="nav-link-custom mt-auto">
            <i class="bi bi-box-arrow-right"></i> Çıkış Yap
        </a>
    </aside>

    <!-- Ana İçerik Alanı -->
    <main class="main-content">
        <!-- Üst Bilgi Barı (Header) -->
        <header class="d-flex justify-content-end align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-bell fs-5 text-muted"></i>
                <div class="d-flex align-items-center gap-2 bg-white rounded-pill px-3 py-1 shadow-sm">
                    <img src="https://ui-avatars.com/api/?name=Tayfun+Soy&background=0D8ABC&color=fff" alt="Profil" class="rounded-circle" style="width: 32px; height: 32px;">
                    <div>
                        <span class="fw-bold fs-6 d-block" style="line-height: 1;">Murti</span>
                        <small class="text-muted" style="font-size: 0.75rem;">Seviye 5</small>
                    </div>
                </div>
            </div>
        </header>

        <!-- Her sayfanın (örneğin Dashboard'un) içeriği buraya render edilecek -->
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>