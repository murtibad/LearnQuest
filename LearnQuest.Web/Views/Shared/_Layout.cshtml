<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LearnQuest</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%234F46E5'><path d='M8 2.223 1 5.373v.13l7 3.15 7-3.15v-.13L8 2.223zm0 6.5-6-2.7v5.47c0 1.25.968 2.378 2.802 2.92C6.183 14.836 7.151 15 8 15c.849 0 1.817-.164 3.198-.587 1.834-.542 2.802-1.67 2.802-2.92V6.023l-6 2.7z'/></svg>">

    @await Html.PartialAsync("_ThemeInit")
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .app-container { display: flex; min-height: 100vh; }
        .main-content { flex-grow: 1; margin-left: 260px; padding-bottom: 2rem; }
        .sidebar { 
            width: 260px; background-color: var(--sidebar-bg); border-right: 1px solid var(--border-color); 
            display: flex; flex-direction: column; padding: 24px; position: fixed; height: 100vh; 
            transition: background-color 0.3s ease, border-color 0.3s ease;
        }
        .theme-btn {
            background: transparent; border: 1px solid var(--border-color);
            border-radius: 12px; padding: 10px; width: 100%; text-align: left;
            display: flex; align-items: center; justify-content: center; gap: 10px;
            color: var(--text-main); transition: all 0.3s ease; cursor: pointer;
        }
        .theme-btn:hover { background-color: var(--hover-bg); }
    </style>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.6/dist/sweetalert2.min.css" rel="stylesheet">
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    }
    <div class="app-container">
        <!-- Partial: _Sidebar -->
        <aside class="sidebar">
            
            <a href="/" class="sidebar-logo">
                <div class="logo-icon logo-icon-lg"><i class="bi bi-mortarboard-fill"></i></div>
                LearnQuest
            </a>
            <nav class="flex-column flex-grow-1">
                <div class="nav-item"><a href="/Dashboard" class="nav-link @(currentController == "Dashboard" && currentAction == "Index" ? "active" : "")"><i class="bi bi-house-door-fill"></i> Ana Sayfa</a></div>
                <div class="nav-item"><a href="/Courses" class="nav-link @(currentController == "Courses" ? "active" : "")"><i class="bi bi-book-half"></i> Dersler</a></div>
                <div class="nav-item"><a href="/Dashboard/Quiz" class="nav-link @(currentController == "Dashboard" && currentAction == "Quiz" ? "active" : "")"><i class="bi bi-controller"></i> Quiz Arena</a></div>
                <div class="nav-item"><a href="/Dashboard/Statistics" class="nav-link @(currentAction == "Statistics" ? "active" : "")"><i class="bi bi-bar-chart-line-fill"></i> İstatistikler</a></div>
                <div class="nav-item"><a href="/Dashboard/Profile" class="nav-link @(currentAction == "Profile" ? "active" : "")"><i class="bi bi-person-fill"></i> Profil</a></div>
            </nav>
            <div class="mt-auto d-flex flex-column gap-3">
                <button id="themeToggle" class="theme-btn" type="button">
                    <i id="themeIcon" class="bi bi-moon-stars-fill fs-5"></i>
                    <span class="fw-medium small">Tema Değiştir</span>
                </button>
                <a href="/Auth/Login" class="nav-link mt-2" style="color: var(--text-muted);"><i class="bi bi-box-arrow-right"></i> Çıkış Yap</a>
            </div>
        </aside>
        <main class="main-content">
            <!-- Partial: _TopBar -->
            @RenderBody()
        </main>
        <nav class="mobile-bottom-nav">
            <a href="/Dashboard" class="nav-item"><i class="bi bi-house-door-fill"></i> Ana Sayfa</a>
            <a href="/Courses" class="nav-item"><i class="bi bi-book-half"></i> Dersler</a>
            <a href="/Dashboard/Quiz" class="nav-item"><i class="bi bi-controller"></i> Quiz</a>
            <a href="/Dashboard/Statistics" class="nav-item"><i class="bi bi-bar-chart-line-fill"></i> İstatistikler</a>
            <a href="/Dashboard/Profile" class="nav-item"><i class="bi bi-person-fill"></i> Profil</a>
        </nav>
        <button id="scrollToTop" class="scroll-to-top" aria-label="Yukarı Çık" type="button"><i class="bi bi-chevron-up"></i></button>
    </div>
    
    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.6/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>